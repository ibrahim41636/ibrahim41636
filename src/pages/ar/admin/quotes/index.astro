---
// Staff page for proposals and payments: send the technical and financial proposal with its files
// and payment schedule, follow approvals and payments, and mark a stage complete so its payment
// falls due (the client is e-mailed a payment link). API: functions/api/payments.ts.
import Base from "@/layouts/Base.astro";
---
<Base lang="ar" path="/admin/quotes/" noindex focused title="العروض والمدفوعات" description="إرسال العروض الفنية والمالية ومتابعة الدفعات.">
  <section class="section">
    <div class="container">
      <h1 style="font-size:var(--fs-h2)">العروض والمدفوعات</h1>
      <p><a href="/ar/admin/">→ لوحة الطلبات</a></p>

      <form class="adm-login" data-login>
        <label for="adm-token">رمز الدخول</label>
        <input id="adm-token" type="password" autocomplete="current-password" class="ltr" required />
        <button class="btn" type="submit">دخول</button>
      </form>

      <div data-panel hidden>
        <p class="adm-msg" data-msg hidden></p>
        <p class="q-mode" data-mode></p>

        <form class="card q-form" data-create>
          <h2>عرض جديد</h2>
          <div class="q-grid">
            <label>رقم الطلب<input name="leadId" class="ltr" required placeholder="SEL-2026-000123" pattern="SEL-\d{4}-\d{6}" /></label>
            <label>عنوان العرض<input name="title" required maxlength="160" placeholder="مثال: التصريح البيئي لمصنع الجبيل" /></label>
            <label>قيمة الخدمات بالريال قبل الضريبة<input name="subtotal" class="ltr" required inputmode="decimal" placeholder="25000" /></label>
            <label>صلاحية العرض بالأيام<input name="validDays" class="ltr" type="number" min="1" max="180" value="30" /></label>
          </div>

          <fieldset class="q-plan">
            <legend>جدول الدفعات</legend>
            <div class="q-presets">
              <button type="button" class="btn btn--ghost" data-preset="full">كامل المبلغ عند الموافقة</button>
              <button type="button" class="btn btn--ghost" data-preset="half">50% مقدماً و50% عند التسليم</button>
              <button type="button" class="btn btn--ghost" data-preset="three">30% / 40% / 30%</button>
              <button type="button" class="btn btn--ghost" data-preset="after">كامل المبلغ عند التسليم</button>
            </div>
            <table class="adm-table">
              <thead><tr><th>الدفعة (تظهر للعميل بلغته)</th><th>النسبة %</th><th>تستحق</th><th>المبلغ شامل الضريبة</th><th></th></tr></thead>
              <tbody data-plan></tbody>
            </table>
            <p><button type="button" class="btn btn--ghost" data-add>إضافة دفعة</button></p>
            <p class="q-totals" data-totals></p>
          </fieldset>

          <label>ملفات العرض الفني والمالي (PDF أو Word أو Excel، حتى 5 ملفات و10 ميجابايت)
            <input name="files" type="file" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.zip" />
          </label>
          <p class="muted" style="font-size:var(--fs-14)">تُرسل الملفات للعميل مرفقة بالبريد مع رابط الموافقة والدفع، ولا تُحفظ في الموقع. الدفعة الأولى «عند الموافقة» يدفعها العميل مباشرة بعد الموافقة، وبقية الدفعات تستحق عندما تضغط «إنجاز المرحلة» أدناه.</p>
          <label class="q-check"><input type="checkbox" name="final" value="1" /> عرض نهائي: يظهر للعميل خيار الموافقة والدفع فقط، بدون طلب خصم أو تعديل الدفعات</label>
          <p class="muted" style="font-size:var(--fs-14)">العرض الأول يتيح للعميل طلب خصم أو تقسيم دفعات مختلف مرة واحدة. بعد أن يستخدمها، يكون أي عرض جديد لنفس الطلب نهائياً تلقائياً، ويحل محل العرض السابق.</p>
          <button class="btn" type="submit" data-send>إرسال العرض للعميل</button>
        </form>

        <div class="adm-bar">
          <label>عروض طلب <input data-filter class="ltr" placeholder="SEL-2026-000123" /></label>
          <button class="btn btn--ghost" type="button" data-refresh>تحديث</button>
          <button class="btn btn--ghost" type="button" data-logout>خروج</button>
        </div>
        <div data-list></div>
      </div>
    </div>
  </section>

  <style is:global>
    .adm-login { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: var(--space-6); }
    .adm-login[hidden] { display: none; }
    .adm-login input, .q-form input, .q-form select, .adm-bar input { padding: 10px 12px; border: 1px solid var(--c-line); border-radius: var(--radius-sm); font: inherit; background: #fff; }
    .adm-bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: var(--space-7) 0 var(--space-4); }
    .adm-msg { padding: 10px 14px; border-radius: var(--radius-sm); background: var(--c-mint); margin-top: var(--space-5); }
    .adm-msg.err { background: #fdecea; color: #8a1c12; }
    .q-mode { font-size: var(--fs-14); color: var(--c-muted); }
    .q-form label.q-check { display: flex; gap: 8px; align-items: center; font-weight: 600; }
    .q-form label.q-check input { width: auto; }
    .q-req { margin: var(--space-3) 0 0; padding: 12px 14px; border-radius: var(--radius-sm); background: #fff4d6; color: #5c3d00; font-size: var(--fs-14); white-space: pre-line; }
    .q-mode b.off { color: #8a1c12; }
    .q-form { margin-top: var(--space-5); gap: var(--space-4); }
    .q-form h2 { font-size: var(--fs-h4); margin: 0; }
    .q-form label { display: grid; gap: 6px; font-size: var(--fs-14); font-weight: 600; }
    .q-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
    .q-grid input, .q-form > label input { width: 100%; min-width: 0; box-sizing: border-box; }
    .q-plan { border: 1px solid var(--c-line); border-radius: var(--radius-sm); padding: var(--space-4); margin: 0; min-width: 0; }
    .q-plan legend { font-weight: 600; padding: 0 6px; }
    .q-presets { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-4); }
    .q-presets .btn { padding: 8px 12px; font-size: var(--fs-14); }
    .adm-table { width: 100%; border-collapse: collapse; font-size: var(--fs-14); background: #fff; }
    .adm-table th, .adm-table td { padding: 8px 10px; border-bottom: 1px solid var(--c-line); text-align: start; vertical-align: middle; }
    .adm-table th { background: var(--c-paper-2); white-space: nowrap; }
    .adm-table input[type="number"] { width: 90px; }
    .adm-table input[type="text"] { width: 100%; min-width: 180px; }
    .q-plan .adm-table { display: block; overflow-x: auto; }
    .q-totals { font-weight: 600; }
    .q-totals.err { color: #8a1c12; }
    .q-card { border: 1px solid var(--c-line); border-radius: var(--radius); background: #fff; padding: var(--space-4); margin-bottom: var(--space-4); }
    .q-card header { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: baseline; justify-content: space-between; }
    .q-card h3 { font-size: var(--fs-18); margin: 0; }
    .q-card .meta { font-size: var(--fs-14); color: var(--c-muted); }
    .q-card .adm-table { margin-top: var(--space-3); }
    .q-card .wrap { overflow-x: auto; }
    .q-actions { display: flex; flex-wrap: wrap; gap: 6px; }
    .q-actions .btn { padding: 6px 10px; font-size: var(--fs-12); }
    .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; background: var(--c-paper-2); font-size: var(--fs-12); white-space: nowrap; }
    .pill.due { background: #fff4d6; color: #7a5200; }
    .pill.paid { background: var(--c-mint); color: var(--c-forest); }
    .pill.cancelled { background: #eee; color: #666; }
  </style>

  <script is:inline>
    const KEY = "selorin_admin_token";
    const $ = (s, el = document) => el.querySelector(s);
    let token = sessionStorage.getItem(KEY) || "";
    const ERR = {
      validation: "تأكد من رقم الطلب وعنوان العرض", lead_not_found: "لا يوجد طلب بهذا الرقم", email_failed: "تعذّر إرسال البريد للعميل، لم يُحفظ العرض",
      plan_amount: "تأكد من قيمة الخدمات (رقم بالريال)", plan_empty: "أضف دفعة واحدة على الأقل", plan_too_many: "الحد الأقصى 6 دفعات",
      plan_label: "اكتب اسماً لكل دفعة", plan_percent: "كل نسبة بين 0 و100", plan_sum: "مجموع النسب يجب أن يساوي 100%",
      plan_acceptance_order: "الدفعة «عند الموافقة» تكون الأولى فقط", files_too_many: "الحد الأقصى 5 ملفات", files_too_large: "حجم الملفات أكبر من 10 ميجابايت",
      files_type: "نوع ملف غير مسموح", not_scheduled: "الدفعة ليست مجدولة", quote_not_accepted: "لم يوافق العميل على العرض بعد",
      closed: "الدفعة مدفوعة أو ملغاة", payments_not_configured: "لم يُضبط مفتاح ميسّر في Cloudflare بعد", gateway_error: "تعذّر الاتصال بميسّر",
    };
    const QS = { sent: "بانتظار موافقة العميل", change_requested: "العميل طلب مراجعة", superseded: "استُبدل بعرض محدّث", accepted: "تمت الموافقة", paid: "مدفوع بالكامل", cancelled: "ملغى" };
    ERR.final = "هذا العرض نهائي"; ERR.not_open = "العرض لم يعد مفتوحاً";
    const MS = { scheduled: "مجدولة", due: "مستحقة", paid: "مدفوعة", cancelled: "ملغاة" };
    const TR = { acceptance: "عند الموافقة", milestone: "عند إنجاز المرحلة" };
    const PRESETS = {
      full: [["سداد قيمة العرض", 100, "acceptance"]],
      half: [["دفعة مقدمة", 50, "acceptance"], ["عند تسليم التقرير النهائي", 50, "milestone"]],
      three: [["دفعة مقدمة", 30, "acceptance"], ["بعد الأعمال الميدانية", 40, "milestone"], ["عند تسليم التقرير النهائي", 30, "milestone"]],
      after: [["عند تسليم الأعمال", 100, "milestone"]],
    };
    const sar = (h) => (h / 100).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " ريال";
    const toHalalas = (v) => { const s = String(v).replace(/[,\s٬]/g, "").replace(/[٠-٩]/g, (d) => d.charCodeAt(0) - 0x0660); return /^\d{1,9}(\.\d{1,2})?$/.test(s) ? Math.round(Number(s) * 100) : NaN; };
    const date = (s) => s ? new Date(s.replace(" ", "T") + "Z").toLocaleString("ar-SA-u-ca-gregory", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Riyadh" }) : "";
    const msg = (text, err) => { const m = $("[data-msg]"); m.textContent = text; m.className = "adm-msg" + (err ? " err" : ""); m.hidden = !text; if (text) m.scrollIntoView({ block: "nearest" }); };
    const el = (tag, props = {}, ...kids) => { const e = Object.assign(document.createElement(tag), props); e.append(...kids); return e; };

    async function api(path, init = {}) {
      const headers = { Authorization: `Bearer ${token}`, ...(init.body && !(init.body instanceof FormData) ? { "Content-Type": "application/json" } : {}) };
      const res = await fetch(path, { ...init, headers });
      const body = await res.json().catch(() => ({}));
      if (res.status === 401) { logout(); throw new Error("رمز الدخول غير صحيح"); }
      if (body.error === "admin_not_configured") throw new Error("لم يُضبط ADMIN_TOKEN في Cloudflare بعد");
      if (!res.ok || !body.ok) throw new Error(ERR[body.error] || "تعذّر تنفيذ الطلب");
      return body;
    }

    // ------------------------------------------------ payment plan editor
    const planBody = $("[data-plan]");
    function addRow(label = "", percent = "", trigger = "milestone") {
      const tr = el("tr");
      const name = el("input", { type: "text", value: label, maxLength: 120, required: true });
      const pct = el("input", { type: "number", value: percent, min: "0.01", max: "100", step: "0.01", required: true, className: "ltr" });
      const trig = el("select");
      for (const [v, t] of Object.entries(TR)) trig.append(el("option", { value: v, textContent: t, selected: v === trigger }));
      const amt = el("td", { className: "ltr" });
      const del = el("button", { type: "button", className: "btn btn--ghost", textContent: "حذف", onclick: () => { tr.remove(); totals(); } });
      [name, pct, trig].forEach((i) => i.addEventListener("input", totals));
      tr.append(el("td", {}, name), el("td", {}, pct), el("td", {}, trig), amt, el("td", {}, del));
      tr._get = () => ({ label: name.value.trim(), percent: Number(pct.value), trigger: trig.value });
      tr._amt = amt;
      planBody.append(tr);
    }
    function preset(key) { planBody.replaceChildren(); PRESETS[key].forEach((r) => addRow(...r)); totals(); }
    function rows() { return [...planBody.children].map((tr) => tr._get()); }
    function totals() {
      const sub = toHalalas($("[name=subtotal]").value);
      const list = [...planBody.children];
      const sum = rows().reduce((n, r) => n + (r.percent || 0), 0);
      const out = $("[data-totals]");
      if (!Number.isFinite(sub)) { out.textContent = `مجموع النسب ${sum}%`; out.className = "q-totals" + (Math.abs(sum - 100) > 0.001 ? " err" : ""); list.forEach((tr) => (tr._amt.textContent = "")); return; }
      const vat = Math.round(sub * 0.15), total = sub + vat;
      let used = 0;
      list.forEach((tr, i) => { const a = i === list.length - 1 ? total - used : Math.round(total * (tr._get().percent || 0) / 100); used += a; tr._amt.textContent = sar(a); });
      out.textContent = `قبل الضريبة ${sar(sub)} · الضريبة 15% ${sar(vat)} · الإجمالي ${sar(total)} · مجموع النسب ${Math.round(sum * 100) / 100}%`;
      out.className = "q-totals" + (Math.abs(sum - 100) > 0.001 ? " err" : "");
    }
    document.querySelectorAll("[data-preset]").forEach((b) => (b.onclick = () => preset(b.dataset.preset)));
    $("[data-add]").onclick = () => { addRow(); totals(); };
    $("[name=subtotal]").addEventListener("input", totals);
    preset("half");

    $("[data-create]").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = e.currentTarget.elements; // form.title is the form's own attribute, so read inputs from .elements
      const plan = rows();
      const total = (() => { const s = toHalalas(f.subtotal.value); return Number.isFinite(s) ? s + Math.round(s * 0.15) : NaN; })();
      if (!Number.isFinite(total)) return msg(ERR.plan_amount, true);
      if (!confirm(`سيُرسل العرض إلى بريد العميل بإجمالي ${sar(total)} شامل الضريبة. متابعة؟`)) return;
      const data = new FormData();
      for (const k of ["leadId", "title", "subtotal", "validDays"]) data.set(k, f[k].value.trim());
      data.set("leadId", f.leadId.value.trim().toUpperCase());
      data.set("plan", JSON.stringify(plan));
      if (f.final.checked) data.set("final", "1");
      for (const file of f.files.files) data.append("files", file);
      const btn = $("[data-send]"); btn.disabled = true;
      try {
        const r = await api("/api/admin/quotes", { method: "POST", body: data });
        msg(`أُرسل العرض ${r.quoteId} للعميل بإجمالي ${sar(r.total)}${r.negotiable ? "، ويمكنه طلب مراجعة مرة واحدة" : "، وهو عرض نهائي"}${r.replaces ? `، وحل محل العرض ${r.replaces}` : ""}. رابط العميل محفوظ في القائمة أدناه.`);
        f.final.checked = false;
        $("[data-filter]").value = data.get("leadId");
        f.title.value = ""; f.subtotal.value = ""; f.files.value = ""; totals();
        load();
      } catch (err) { msg(err.message, true); } finally { btn.disabled = false; }
    });

    // ------------------------------------------------ quotes and milestones
    async function act(id, action, confirmText, extra = {}) {
      if (confirmText && !confirm(confirmText)) return;
      try { await api("/api/admin/milestone", { method: "POST", body: JSON.stringify({ id, action, ...extra }) }); msg("تم."); load(); }
      catch (err) { msg(err.message, true); }
    }

    function quoteCard(q) {
      const paid = q.milestones.filter((m) => m.status === "paid").reduce((n, m) => n + m.amount, 0);
      const copy = el("button", { type: "button", className: "btn btn--ghost", textContent: "نسخ رابط العميل", onclick: async () => { try { await navigator.clipboard.writeText(q.link); msg("نُسخ الرابط."); } catch { prompt("رابط العميل:", q.link); } } });
      const cancel = el("button", { type: "button", className: "btn btn--ghost", textContent: "إلغاء العرض", onclick: async () => {
        if (!confirm(`إلغاء العرض ${q.quote_id}؟ تُلغى الدفعات غير المدفوعة وروابطها.`)) return;
        try { await api("/api/admin/quotes/cancel", { method: "POST", body: JSON.stringify({ quoteId: q.quote_id }) }); msg("أُلغي العرض."); load(); } catch (err) { msg(err.message, true); }
      } });
      const head = el("header", {},
        el("h3", { textContent: `${q.quote_id} · ${q.title}` }),
        el("span", { className: "pill " + (q.status === "paid" ? "paid" : q.status === "cancelled" || q.status === "superseded" ? "cancelled" : q.status === "accepted" || q.status === "change_requested" ? "due" : ""), textContent: (QS[q.status] || q.status) + (q.negotiable ? "" : " · نهائي") }),
      );
      // The client's one revision request, and a shortcut to answer it with the revised (final) proposal.
      let req = null;
      if (q.change_requested_at) {
        let c = {}; try { c = JSON.parse(q.change_request || "{}"); } catch {}
        const what = [c.discount ? "خصم" : "", c.schedule ? "تقسيم دفعات مختلف" : ""].filter(Boolean).join(" و");
        req = el("div", { className: "q-req", textContent: `طلب العميل ${what} بتاريخ ${date(q.change_requested_at)}${c.note ? `:\n«${c.note}»` : "."}` });
        if (q.status === "change_requested") {
          req.append(el("br"), el("button", { type: "button", className: "btn", style: "margin-top:10px", textContent: "إعداد العرض المحدّث (نهائي)", onclick: () => {
            const f = $("[data-create]").elements;
            f.leadId.value = q.lead_id; f.title.value = q.title; f.final.checked = true;
            $("[data-create]").scrollIntoView({ behavior: "smooth", block: "start" });
            msg(`عدّل القيمة أو الدفعات حسب طلب العميل ثم أرسل. سيحل العرض الجديد محل ${q.quote_id} ويكون نهائياً.`);
          } }));
        }
      }
      const meta = el("p", { className: "meta", textContent: `الإجمالي ${sar(q.total)} (قبل الضريبة ${sar(q.subtotal)}) · المدفوع ${sar(paid)} · أُرسل ${date(q.created_at)} · ساري حتى ${q.valid_until}${q.accepted_at ? " · وافق " + date(q.accepted_at) : ""}` });
      const tbody = el("tbody");
      for (const m of q.milestones) {
        const actions = el("div", { className: "q-actions" });
        if (m.status === "scheduled" && m.trigger === "milestone" && q.status === "accepted") {
          actions.append(el("button", { type: "button", className: "btn", textContent: "إنجاز المرحلة وطلب الدفعة", onclick: () => act(m.id, "due", `تأكيد إنجاز «${m.label}»؟ يصل العميل بريد بطلب سداد ${sar(m.amount)}.`) }));
        }
        if (m.status === "scheduled" || m.status === "due") {
          actions.append(el("button", { type: "button", className: "btn btn--ghost", textContent: "تسجيل دفع يدوي", onclick: () => {
            const ref = prompt("مرجع التحويل البنكي أو الدفع (يظهر في الإيصال):", "تحويل بنكي");
            if (ref !== null) act(m.id, "paid", `تسجيل «${m.label}» مدفوعة بمبلغ ${sar(m.amount)}؟ يصل العميل إيصال بالبريد.`, { reference: ref });
          } }));
          actions.append(el("button", { type: "button", className: "btn btn--ghost", textContent: "إلغاء الدفعة", onclick: () => act(m.id, "cancel", `إلغاء دفعة «${m.label}»؟`) }));
        }
        tbody.append(el("tr", {},
          el("td", { textContent: m.seq }), el("td", { textContent: m.label }), el("td", { textContent: `${Number(m.percent)}% · ${TR[m.trigger]}` }),
          el("td", { className: "ltr", textContent: sar(m.amount) }),
          el("td", {}, el("span", { className: "pill " + m.status, textContent: MS[m.status] || m.status })),
          el("td", { textContent: m.paid_at ? `${date(m.paid_at)}${m.payment_id ? " · " + m.payment_id : ""}` : m.due_at ? `مستحقة منذ ${date(m.due_at)}${m.reminders ? ` · تذكيرات ${m.reminders}` : ""}` : "" }),
          el("td", {}, actions),
        ));
      }
      const table = el("table", { className: "adm-table" }, el("thead", {}, el("tr", {}, ...["#", "الدفعة", "تستحق", "المبلغ", "الحالة", "التاريخ", ""].map((t) => el("th", { textContent: t })))), tbody);
      const foot = el("div", { className: "q-actions", style: "margin-top:12px" }, copy, ...(["paid", "cancelled", "superseded"].includes(q.status) ? [] : [cancel]));
      return el("article", { className: "q-card" }, head, meta, ...(req ? [req] : []), el("div", { className: "wrap" }, table), foot);
    }

    async function load() {
      try {
        const lead = $("[data-filter]").value.trim().toUpperCase();
        const r = await api(`/api/admin/quotes${lead ? `?lead=${encodeURIComponent(lead)}` : ""}`);
        const mode = $("[data-mode]");
        mode.replaceChildren("الدفع الإلكتروني عبر ميسّر: ", el("b", { className: r.payments === "off" ? "off" : "", textContent: r.payments === "live" ? "مفعّل (حقيقي)" : r.payments === "test" ? "وضع التجربة (مفتاح sk_test)" : "غير مفعّل، أضف MOYASAR_SECRET_KEY في Cloudflare" }));
        const list = $("[data-list]");
        list.replaceChildren(...r.quotes.map(quoteCard));
        if (!r.quotes.length) list.append(el("p", { className: "muted", textContent: "لا توجد عروض بعد." }));
      } catch (err) { msg(err.message, true); }
    }

    function logout() { token = ""; sessionStorage.removeItem(KEY); $("[data-panel]").hidden = true; $("[data-login]").hidden = false; }
    function start() { $("[data-login]").hidden = true; $("[data-panel]").hidden = false; load(); }
    const qp = new URLSearchParams(location.search).get("lead");
    if (qp) { $("[name=leadId]").value = qp; $("[data-filter]").value = qp; }
    $("[data-login]").addEventListener("submit", (e) => { e.preventDefault(); token = $("#adm-token").value.trim(); sessionStorage.setItem(KEY, token); start(); });
    $("[data-refresh]").onclick = load;
    $("[data-filter]").addEventListener("change", load);
    $("[data-logout]").onclick = logout;
    if (token) start();
  </script>
</Base>
