---
import { pageImage } from "@/data/imagery";
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import { href, t, type Lang } from "@/i18n/ui";
import { categories } from "@/data/taxonomy";
import { getServices } from "@/lib/content";
import { collectionSchema } from "@/lib/schema";
interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
const services = await getServices();
const crumbs = [{ name: t(lang, "nav.home"), path: "/" }, { name: t(lang, "nav.services"), path: "/services/" }];
---
<Base lang={lang} path="/services/" breadcrumbs={crumbs}
  title={ar ? "الخدمات البيئية في المملكة | التصاريح والدراسات والرصد والاستدامة" : "Environmental Services in Saudi Arabia | Selorin"}
  description={ar ? "خدمات سيلورين البيئية: التصاريح والامتثال، وتقييم الأثر البيئي، والرصد البيئي، وإدارة النفايات، والاستدامة والحوكمة البيئية، والمباني المستدامة." : "Selorin's environmental services: permitting and compliance, EIA, environmental monitoring, waste management, ESG and climate, and sustainable buildings in Saudi Arabia."}
  schema={[collectionSchema(lang, "/services/", t(lang, "nav.services"), services.map((s) => ({ name: s.data[lang].name, path: `/services/${s.id}/` })))]}
  analytics={{ page_type: "services_hub" }}>
  <PageHero lang={lang} crumbs={crumbs} photo={pageImage("services")} eyebrow={t(lang, "nav.services")}
    title={ar ? "خدمات بيئية مترابطة، من الدراسة إلى الامتثال المستمر" : "Connected environmental services, from first study to ongoing compliance"}
    lead={ar ? "22 خدمة ضمن ستة مجالات، يربط بينها فريق واحد يفهم متطلباتك التنظيمية ويحوّلها إلى مخرجات واضحة." : "22 services across six practice areas, connected by one team that understands your regulatory requirements and turns them into clear deliverables."} />
  <nav class="section-tight bg-white border-top" aria-label={ar ? "المجالات" : "Practice areas"} style="padding-block:20px">
    <div class="container" style="display:flex;flex-wrap:wrap;gap:8px">
      {categories.map((c) => <a class="pill" href={`#${c.id}`} style="text-decoration:none;padding:8px 14px">{c.name[lang]}</a>)}
    </div>
  </nav>
  {categories.map((c, i) => (
    <section class:list={["section", { "bg-white": i % 2 === 1 }]} id={c.id} aria-labelledby={`h-${c.id}`}>
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">{String(i + 1).padStart(2, "0")} — {t(lang, "nav.services")}</p>
            <h2 id={`h-${c.id}`}>{c.name[lang]}</h2>
          </div>
          <div style="max-width:52ch">
            <p class="lead">{c.intro[lang]}</p>
            <a class="link mt-4" href={href(lang, `/services/${c.id}/`)}>{ar ? "نظرة على المجال" : "Practice area overview"} <Icon name="arrow" /></a>
          </div>
        </div>
        <div class="grid grid-3">{services.filter((s) => s.data.category === c.id).map((s) => <ServiceCard lang={lang} service={s} />)}</div>
      </div>
    </section>
  ))}
  <CtaBand title={t(lang, "nav.notSure")} body={t(lang, "nav.notSureBody")} label={t(lang, "cta.consultation")} to={href(lang, "/request/")} cta="services_final_cta"
    secondary={{ label: t(lang, "nav.findSupport"), to: href(lang, "/#lifecycle") }} />
</Base>
