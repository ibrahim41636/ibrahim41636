---
import Article from "@/views/Article.astro";
import { getInsights, insightSlug } from "@/lib/content";
export async function getStaticPaths() {
  return (await getInsights("ar")).map((post) => ({ params: { slug: insightSlug(post) }, props: { post } }));
}
---
<Article lang="ar" post={Astro.props.post} />
