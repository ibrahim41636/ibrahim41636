---
// Staff project centre: the team's open steps with their timers (first proposal, revised
// proposal, meeting time), sending a proposal with its payment schedule and the methodology's work
// stages, following each project (meetings, contract, stages, payments), and the contract settings
// (company details, signature and stamp). API: functions/api/payments.ts and functions/api/portal.ts.
import Base from "@/layouts/Base.astro";
---
<Base lang="ar" path="/admin/quotes/" noindex focused title="العروض والمشاريع" description="مهام الفريق والعروض والعقود ومراحل التنفيذ والمدفوعات.">
  <section class="section">
    <div class="container">
      <h1 style="font-size:var(--fs-h2)">العروض والمشاريع</h1>
      <p><a href="/ar/admin/">→ لوحة الطلبات</a></p>

      <form class="adm-login" data-login>
        <label for="adm-token">رمز الدخول</label>
        <input id="adm-token" type="password" autocomplete="current-password" class="ltr" required />
        <button class="btn" type="submit">دخول</button>
      </form>

      <div data-panel hidden>
        <p class="adm-msg" data-msg hidden></p>
        <nav class="adm-tabs" role="tablist">
          <button type="button" role="tab" data-tab="tasks" aria-selected="true">المهام والمؤقتات <span class="count" data-task-count hidden></span></button>
          <button type="button" role="tab" data-tab="new" aria-selected="false">عرض جديد</button>
          <button type="button" role="tab" data-tab="projects" aria-selected="false">المشاريع</button>
          <button type="button" role="tab" data-tab="settings" aria-selected="false">الإعدادات</button>
          <button type="button" class="adm-logout" data-logout>خروج</button>
        </nav>

        <!-- ------------------------------------------------ tasks -->
        <section data-pane="tasks">
          <p class="muted adm-hint" data-sla></p>
          <div data-tasks></div>
        </section>

        <!-- ------------------------------------------------ new proposal -->
        <section data-pane="new" hidden>
          <form class="card q-form" data-create>
            <h2>عرض فني ومالي جديد</h2>
            <div class="q-grid">
              <label>رقم الطلب<input name="leadId" class="ltr" required placeholder="SEL-2026-000123" pattern="SEL-\d{4}-\d{6}" /></label>
              <label>عنوان العرض<input name="title" required maxlength="160" placeholder="مثال: التصريح البيئي لمصنع الجبيل" /></label>
              <label>قيمة الخدمات بالريال قبل الضريبة<input name="subtotal" class="ltr" required inputmode="decimal" placeholder="25000" /></label>
              <label>صلاحية العرض بالأيام<input name="validDays" class="ltr" type="number" min="1" max="180" value="30" /></label>
            </div>

            <div class="q-presets">
              <span>قوالب سريعة:</span>
              <button type="button" class="btn btn--ghost" data-preset="full">كامل المبلغ عند الموافقة</button>
              <button type="button" class="btn btn--ghost" data-preset="half">50% مقدماً و50% عند التسليم</button>
              <button type="button" class="btn btn--ghost" data-preset="three">30% / 40% / 30%</button>
              <button type="button" class="btn btn--ghost" data-preset="after">كامل المبلغ عند التسليم</button>
            </div>

            <fieldset class="q-plan">
              <legend>مراحل التنفيذ الفني (حسب العرض الفني ومنهجية العمل)</legend>
              <ol class="q-stages" data-stages></ol>
              <p><button type="button" class="btn btn--ghost" data-add-stage>إضافة مرحلة</button></p>
              <p class="muted adm-hint">يرى العميل هذه المراحل في بوابته. تبدأ الأولى بعد توقيع العقد وسداد الدفعة المقدمة، ولا تبدأ أي مرحلة حتى تُسدد الدفعة المرتبطة بالمرحلة السابقة.</p>
            </fieldset>

            <fieldset class="q-plan">
              <legend>جدول الدفعات</legend>
              <div class="wrap">
                <table class="adm-table">
                  <thead><tr><th>الدفعة (تظهر للعميل)</th><th>النسبة %</th><th>تستحق</th><th>المرحلة</th><th>المبلغ شامل الضريبة</th><th></th></tr></thead>
                  <tbody data-plan></tbody>
                </table>
              </div>
              <p><button type="button" class="btn btn--ghost" data-add>إضافة دفعة</button></p>
              <p class="q-totals" data-totals></p>
            </fieldset>

            <label>ملفات العرض الفني والمالي (PDF أو Word أو Excel، حتى 5 ملفات و10 ميجابايت)
              <input name="files" type="file" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.zip" />
            </label>
            <label>التعديلات في هذا الإصدار (للعرض المحدّث، تظهر للعميل في البوابة)
              <textarea name="revisionNote" rows="3" maxlength="1000" placeholder="مثال: خصم 5% وتقسيم الدفعة الثانية على مرحلتين بناءً على الاجتماع"></textarea>
            </label>
            <label class="q-check"><input type="checkbox" name="final" value="1" /> عرض نهائي: يظهر للعميل خيار الموافقة والسداد فقط، بدون اجتماع أو طلب خصم</label>
            <p class="muted adm-hint">تُرسل الملفات للعميل مرفقة بالبريد مع رابط بوابته، وتُحفظ نسخة في مجلد الطلب على Google Drive إن كان مفعلاً. يمكن للعميل طلب خصم أو تقسيم دفعات مرة واحدة فقط، وبعدها يكون أي عرض جديد للطلب نهائياً تلقائياً ويحل محل السابق.</p>
            <button class="btn" type="submit" data-send>إرسال العرض للعميل</button>
          </form>
        </section>

        <!-- ------------------------------------------------ projects -->
        <section data-pane="projects" hidden>
          <div class="adm-bar">
            <label>طلب <input data-filter class="ltr" placeholder="SEL-2026-000123" /></label>
            <button class="btn btn--ghost" type="button" data-refresh>تحديث</button>
            <span class="q-mode" data-mode></span>
          </div>
          <div data-list></div>
        </section>

        <!-- ------------------------------------------------ settings -->
        <section data-pane="settings" hidden>
          <form class="card q-form" data-settings>
            <h2>بيانات سيلورين في العقد</h2>
            <div class="q-grid">
              <label>الاسم القانوني<input name="legalName" maxlength="200" placeholder="سيلورين للاستشارات والخدمات البيئية" /></label>
              <label>رقم السجل التجاري<input name="crNumber" class="ltr" maxlength="30" /></label>
              <label>الرقم الضريبي<input name="vatNumber" class="ltr" maxlength="30" /></label>
              <label>العنوان<input name="address" maxlength="200" /></label>
              <label>اسم المفوّض بالتوقيع<input name="signatoryName" maxlength="120" /></label>
              <label>المنصب<input name="signatoryTitle" maxlength="120" /></label>
              <label>الهاتف<input name="phone" class="ltr" maxlength="30" placeholder="+966 55 015 6887" /></label>
              <label>البريد<input name="email" class="ltr" maxlength="120" placeholder="sales@selorin.co" /></label>
            </div>
            <div class="q-grid">
              <div class="q-img">
                <label>صورة التوقيع (PNG بخلفية شفافة، حتى 400 كيلوبايت)<input name="signature" type="file" accept=".png,.jpg,.jpeg" /></label>
                <img data-sig alt="التوقيع الحالي" hidden />
              </div>
              <div class="q-img">
                <label>صورة الختم (PNG بخلفية شفافة، حتى 400 كيلوبايت)<input name="stamp" type="file" accept=".png,.jpg,.jpeg" /></label>
                <img data-stamp alt="الختم الحالي" hidden />
              </div>
            </div>
            <p class="muted adm-hint">تُحفظ صورتا التوقيع والختم في قاعدة البيانات فقط (لا في المستودع)، وتظهران في العقد عند إصداره بعد سداد الدفعة المقدمة. يُنصح بمراجعة نص العقد مع مستشار قانوني قبل التشغيل.</p>
            <button class="btn" type="submit">حفظ الإعدادات</button>
          </form>
          <div class="card q-form" style="margin-top:var(--space-5)">
            <h2>حالة الربط</h2>
            <ul class="adm-status" data-status></ul>
          </div>
        </section>
      </div>
    </div>
  </section>

  <style is:global>
    [data-panel][hidden], [data-pane][hidden], .adm-login[hidden], .count[hidden] { display: none; }
    .adm-login { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: var(--space-6); }
    .adm-login input, .q-form input, .q-form select, .q-form textarea, .adm-bar input, .q-card input, .q-card select, .q-card textarea { padding: 10px 12px; border: 1px solid var(--c-line); border-radius: var(--radius-sm); font: inherit; background: #fff; }
    .adm-msg { padding: 10px 14px; border-radius: var(--radius-sm); background: var(--c-mint); margin-top: var(--space-5); white-space: pre-line; }
    .adm-msg.err { background: #fdecea; color: #8a1c12; }
    .adm-hint { font-size: var(--fs-14); margin: 0; }
    .adm-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin: var(--space-6) 0 var(--space-5); border-bottom: 1px solid var(--c-line); }
    .adm-tabs button { font: inherit; font-weight: 600; padding: 10px 16px; border: 0; background: none; border-bottom: 3px solid transparent; cursor: pointer; color: var(--c-muted); }
    .adm-tabs button[aria-selected="true"] { color: var(--c-forest); border-bottom-color: var(--c-forest-2); }
    .adm-tabs .adm-logout { margin-inline-start: auto; font-weight: 400; }
    .adm-tabs .count { display: inline-grid; place-items: center; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; background: #c0392b; color: #fff; font-size: 12px; }
    .adm-bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: 0 0 var(--space-4); }
    .q-mode { font-size: var(--fs-14); color: var(--c-muted); }
    .q-mode b.off { color: #8a1c12; }
    .q-form { gap: var(--space-4); }
    .q-form h2 { font-size: var(--fs-h4); margin: 0; }
    .q-form label { display: grid; gap: 6px; font-size: var(--fs-14); font-weight: 600; }
    .q-form label.q-check { display: flex; gap: 8px; align-items: center; }
    .q-form label.q-check input { width: auto; }
    .q-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
    .q-grid input, .q-form > label input, .q-form > label textarea { width: 100%; min-width: 0; box-sizing: border-box; }
    .q-plan { border: 1px solid var(--c-line); border-radius: var(--radius-sm); padding: var(--space-4); margin: 0; min-width: 0; display: grid; gap: var(--space-3); }
    .q-plan legend { font-weight: 600; padding: 0 6px; }
    .q-plan p { margin: 0; }
    .q-presets { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: var(--fs-14); }
    .q-presets .btn, .q-plan .btn, .q-card .btn { min-height: 36px; padding: 0 12px; font-size: var(--fs-14); }
    .q-stages { margin: 0; padding-inline-start: 24px; display: grid; gap: 8px; }
    .q-stages li { display: flex; gap: 8px; align-items: center; }
    .q-stages input { flex: 1; min-width: 0; }
    .wrap { overflow-x: auto; }
    .adm-table { width: 100%; border-collapse: collapse; font-size: var(--fs-14); background: #fff; }
    .adm-table th, .adm-table td { padding: 8px 10px; border-bottom: 1px solid var(--c-line); text-align: start; vertical-align: middle; }
    .adm-table th { background: var(--c-paper-2); white-space: nowrap; }
    .adm-table input[type="number"] { width: 90px; }
    .adm-table input[type="text"] { width: 100%; min-width: 180px; }
    .q-totals { font-weight: 600; }
    .q-totals.err, .err-text { color: #8a1c12; }
    .q-img { display: grid; gap: 8px; align-content: start; }
    .q-img img { max-width: 220px; max-height: 120px; object-fit: contain; border: 1px dashed var(--c-line); border-radius: var(--radius-sm); padding: 8px; background: #fff; }
    .q-img img[hidden] { display: none; }
    .adm-status { margin: 0; padding-inline-start: 20px; display: grid; gap: 6px; font-size: var(--fs-15); }
    .task { display: grid; grid-template-columns: 1fr auto; gap: 8px 16px; align-items: start; padding: 14px 16px; border: 1px solid var(--c-line); border-inline-start: 5px solid var(--c-forest-2); border-radius: var(--radius); background: #fff; margin-bottom: 10px; }
    .task.soon { border-inline-start-color: #e0a100; }
    .task.late { border-inline-start-color: #c0392b; background: #fffafa; }
    .task h3 { font-size: var(--fs-16); margin: 0; }
    .task .meta { font-size: var(--fs-14); color: var(--c-muted); margin: 4px 0 0; }
    .task .detail { font-size: var(--fs-14); margin: 6px 0 0; white-space: pre-line; }
    .task .clock { font-weight: 700; font-variant-numeric: tabular-nums; text-align: end; white-space: nowrap; }
    .task.late .clock { color: #c0392b; }
    .task.soon .clock { color: #9a6b00; }
    .task .clock small { display: block; font-weight: 400; color: var(--c-muted); font-size: var(--fs-12); }
    .task .row { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .task .row .btn { min-height: 36px; padding: 0 12px; font-size: var(--fs-14); }
    .task .row input { padding: 7px 10px; border: 1px solid var(--c-line); border-radius: var(--radius-sm); font: inherit; }
    .q-card { border: 1px solid var(--c-line); border-radius: var(--radius); background: #fff; padding: var(--space-4); margin-bottom: var(--space-4); display: grid; gap: var(--space-3); }
    .q-old { background: var(--c-paper-2); }
    .q-old summary { cursor: pointer; list-style: none; }
    .q-old summary::-webkit-details-marker { display: none; }
    .q-old[open] summary { margin-bottom: var(--space-2); }
    .q-card header { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: baseline; justify-content: space-between; }
    .q-card h3 { font-size: var(--fs-18); margin: 0; }
    .q-card h4 { font-size: var(--fs-15); margin: var(--space-2) 0 0; }
    .q-card .meta { font-size: var(--fs-14); color: var(--c-muted); margin: 0; }
    .q-card .links { display: flex; flex-wrap: wrap; gap: 8px; }
    .q-req { margin: 0; padding: 12px 14px; border-radius: var(--radius-sm); background: #fff4d6; color: #5c3d00; font-size: var(--fs-14); white-space: pre-line; }
    .q-box { padding: 12px 14px; border-radius: var(--radius-sm); background: var(--c-paper-2); font-size: var(--fs-14); display: grid; gap: 8px; }
    .q-box p { margin: 0; }
    .q-actions { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .q-actions .btn { min-height: 32px; padding: 0 10px; font-size: var(--fs-12); }
    .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; background: var(--c-paper-2); font-size: var(--fs-12); white-space: nowrap; }
    .pill.due, .pill.locked, .pill.requested, .pill.details { background: #fff4d6; color: #7a5200; }
    .pill.paid, .pill.done, .pill.held, .pill.countersigned, .pill.active { background: var(--c-mint); color: var(--c-forest); }
    .pill.cancelled { background: #eee; color: #666; }
  </style>

  <script is:inline>
    const KEY = "selorin_admin_token";
    const $ = (s, root = document) => root.querySelector(s);
    let token = sessionStorage.getItem(KEY) || "";
    const ERR = {
      validation: "تأكد من البيانات المدخلة", lead_not_found: "لا يوجد طلب بهذا الرقم", email_failed: "تعذّر إرسال البريد للعميل، لم يُحفظ العرض",
      plan_amount: "تأكد من قيمة الخدمات (رقم بالريال)", plan_empty: "أضف دفعة واحدة على الأقل", plan_too_many: "الحد الأقصى 6 دفعات",
      plan_label: "اكتب اسماً لكل دفعة", plan_percent: "كل نسبة بين 0 و100", plan_sum: "مجموع النسب يجب أن يساوي 100%",
      plan_acceptance_order: "الدفعة «عند الموافقة» تكون الأولى فقط", plan_stage_title: "اسم المرحلة أطول من 160 حرفاً",
      plan_stage_link: "اربط كل دفعة «عند إنجاز المرحلة» بمرحلة من القائمة", plan_too_many_stages: "الحد الأقصى 12 مرحلة",
      files_too_many: "الحد الأقصى 5 ملفات", files_too_large: "حجم الملفات أكبر من 10 ميجابايت", files_type: "نوع ملف غير مسموح",
      has_accepted: "للطلب عرض معتمد. ألغِه أولاً إن أردت إرسال عرض بديل", not_scheduled: "الدفعة ليست مجدولة", quote_not_accepted: "لم يوافق العميل على العرض بعد",
      stage_linked: "هذه الدفعة مرتبطة بمرحلة، وتستحق تلقائياً عند إنجاز المرحلة", closed: "الدفعة مدفوعة أو ملغاة",
      payments_not_configured: "لم يُضبط مفتاح ميسّر في Cloudflare بعد", gateway_error: "تعذّر الاتصال بميسّر", not_active: "المرحلة ليست جارية الآن",
      not_issued: "العقد لم يصدر بعد", not_found: "غير موجود، حدّث الصفحة", signature_file: "التوقيع: PNG أو JPG حتى 400 كيلوبايت",
      stamp_file: "الختم: PNG أو JPG حتى 400 كيلوبايت", quote_closed: "هذا العرض استُبدل أو أُلغي، والعمل على العرض الحالي", server_error: "خطأ في الخادم، حاول مرة أخرى", tracking_unavailable: "قاعدة البيانات غير مربوطة",
    };
    const QS = { sent: "بانتظار العميل", change_requested: "العميل طلب خصماً أو تقسيماً", superseded: "استُبدل بعرض محدّث", accepted: "تمت الموافقة", paid: "مدفوع بالكامل", cancelled: "ملغى" };
    const MS = { scheduled: "مجدولة", due: "مستحقة", paid: "مدفوعة", cancelled: "ملغاة" };
    const TR = { acceptance: "عند الموافقة", milestone: "عند إنجاز المرحلة" };
    const WS = { done: "مكتملة", active: "جارية", ready: "جاهزة", locked: "مقفلة بانتظار سداد", waiting: "بانتظار العقد والدفعة المقدمة", upcoming: "لاحقة" };
    const CS = { details: "بانتظار الدفعة المقدمة", issued: "صادر، بانتظار نسخة العميل الموقعة", countersigned: "موقع من الطرفين" };
    const MT = { requested: "بانتظار تحديد الموعد", scheduled: "محدد", held: "عُقد", cancelled: "ملغى" };
    const MODES = { online: "مرئي عن بعد", office: "في المكتب", site: "في الموقع", phone: "مكالمة" };
    const LS = { received: "مستلم", reviewing: "قيد المراجعة", quoted: "أُرسل العرض", in_progress: "قيد التنفيذ", completed: "مكتمل", closed: "مغلق" };
    const TASK = { proposal: "إعداد العرض الأول", discount: "عرض محدّث نهائي بعد طلب خصم أو تقسيم", meeting: "تحديد موعد الاجتماع", meeting_revision: "عرض معدّل بعد الاجتماع" };
    const PRESETS = {
      full: { stages: ["تنفيذ الأعمال وتسليم المخرجات"], rows: [["سداد قيمة العرض", 100, "acceptance"]] },
      half: { stages: ["تنفيذ الأعمال وتسليم التقرير النهائي"], rows: [["دفعة مقدمة", 50, "acceptance"], ["عند تسليم التقرير النهائي", 50, "milestone", 1]] },
      three: { stages: ["الأعمال الميدانية وجمع البيانات", "التحليل وإعداد التقرير النهائي"], rows: [["دفعة مقدمة", 30, "acceptance"], ["بعد الأعمال الميدانية", 40, "milestone", 1], ["عند تسليم التقرير النهائي", 30, "milestone", 2]] },
      after: { stages: ["تنفيذ الأعمال وتسليم المخرجات"], rows: [["عند تسليم الأعمال", 100, "milestone", 1]] },
    };
    const sar = (x) => (x / 100).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " ريال";
    const toHalalas = (v) => { const s = String(v).replace(/[,\s٬]/g, "").replace(/[٠-٩]/g, (d) => d.charCodeAt(0) - 0x0660); return /^\d{1,9}(\.\d{1,2})?$/.test(s) ? Math.round(Number(s) * 100) : NaN; };
    const utc = (s) => new Date(s.includes("T") ? s : s.replace(" ", "T") + "Z");
    const date = (s) => s ? utc(s).toLocaleString("ar-SA-u-ca-gregory", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Riyadh" }) : "";
    const msg = (text, err) => { const m = $("[data-msg]"); m.textContent = text; m.className = "adm-msg" + (err ? " err" : ""); m.hidden = !text; if (text) m.scrollIntoView({ block: "nearest", behavior: "smooth" }); };
    function el(tag, props = {}, ...kids) {
      const e = document.createElement(tag);
      for (const [k, v] of Object.entries(props)) {
        if (v === null || v === undefined || v === false) continue;
        if (k === "class") e.className = v; else if (k === "text") e.textContent = v;
        else if (k.startsWith("on")) e.addEventListener(k.slice(2), v);
        else if (k in e && typeof v !== "string") e[k] = v; else e.setAttribute(k, v === true ? "" : v);
