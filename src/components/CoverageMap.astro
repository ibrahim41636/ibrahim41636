---
// Service coverage map: Saudi cities plus the countries we serve in the region.
// The base map (public/images/maps/middle-east.svg) is drawn from Natural Earth country
// outlines with a Mercator projection fitted to lon 27..60.5, lat 14.5..35.5 in a 1000×697 box.
// x/y below are the projected city positions in that box; lx/ly is where the label sits and
// `a` is its text anchor. Each label has an arrow that starts at the name and ends at the pin.
import type { Lang } from "@/i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
const W = 1000, H = 697;

type Anchor = "start" | "middle" | "end";
interface Place { id: string; en: string; ar: string; x: number; y: number; lx: number; ly: number; a: Anchor; region?: boolean; hq?: boolean }
const PLACES: Place[] = [
  { id: "riyadh", en: "Riyadh", ar: "الرياض", x: 587, y: 373, lx: 587, ly: 437, a: "middle", hq: true },
  { id: "jeddah", en: "Jeddah", ar: "جدة", x: 364, y: 478, lx: 315, ly: 493, a: "end" },
  { id: "makkah", en: "Makkah", ar: "مكة المكرمة", x: 384, y: 481, lx: 427, ly: 524, a: "start" },
  { id: "madinah", en: "Madinah", ar: "المدينة المنورة", x: 375, y: 379, lx: 427, ly: 387, a: "start" },
  { id: "yanbu", en: "Yanbu", ar: "ينبع", x: 330, y: 393, lx: 284, ly: 413, a: "end" },
  { id: "tabuk", en: "Tabuk & NEOM", ar: "تبوك ونيوم", x: 286, y: 251, lx: 235, ly: 312, a: "end" },
  { id: "hail", en: "Hail", ar: "حائل", x: 439, y: 280, lx: 421, ly: 219, a: "middle" },
  { id: "qassim", en: "Qassim", ar: "القصيم", x: 507, y: 319, lx: 525, ly: 259, a: "start" },
  { id: "jubail", en: "Jubail", ar: "الجبيل", x: 676, y: 297, lx: 723, ly: 248, a: "start" },
  { id: "dammam", en: "Dammam & Khobar", ar: "الدمام والخبر", x: 691, y: 320, lx: 763, ly: 290, a: "start" },
  { id: "abha", en: "Abha", ar: "أبها", x: 463, y: 581, lx: 513, ly: 583, a: "start" },
  { id: "jazan", en: "Jazan", ar: "جازان", x: 464, y: 623, lx: 506, ly: 652, a: "start" },
  { id: "qatar", en: "Qatar", ar: "قطر", x: 732, y: 354, lx: 732, ly: 418, a: "middle", region: true },
  { id: "uae", en: "UAE", ar: "الإمارات", x: 844, y: 357, lx: 858, ly: 433, a: "middle", region: true },
  { id: "oman", en: "Oman", ar: "عُمان", x: 937, y: 410, lx: 951, ly: 477, a: "middle", region: true },
  { id: "iraq", en: "Iraq", ar: "العراق", x: 518, y: 79, lx: 578, ly: 40, a: "start", region: true },
  { id: "cairo", en: "Cairo", ar: "القاهرة", x: 127, y: 194, lx: 127, ly: 131, a: "middle", region: true },
];

// Arrow from the edge of the label to the pin: to the pin head when the label sits above or
// beside it, to the tip when the label sits below.
const HEAD = 13;
const arrows = PLACES.map((p) => {
  const below = p.a === "middle" && p.ly > p.y;
  const sx = p.a === "end" ? p.lx + 6 : p.a === "start" ? p.lx - 6 : p.lx;
  const sy = p.a === "middle" ? (below ? p.ly - 17 : p.ly + 6) : p.ly - 5;
  const tx = p.x, ty = below ? p.y + 1 : p.y - HEAD;
  const dx = tx - sx, dy = ty - sy, len = Math.hypot(dx, dy) || 1;
  const gap = below ? 4 : 10;
  return { id: p.id, d: `M${sx.toFixed(1)} ${sy.toFixed(1)} L${(tx - (dx / len) * gap).toFixed(1)} ${(ty - (dy / len) * gap).toFixed(1)}` };
});
const pin = "M0 0C-1.6-4.6-7-8-7-13.5a7 7 0 1 1 14 0C7-8 1.6-4.6 0 0Z";
const saudi = PLACES.filter((p) => !p.region);
const region = PLACES.filter((p) => p.region);
---
<figure class="cov-map">
  <div class="cov-map-scroll" dir="ltr" tabindex="0" role="group" aria-label={ar ? "خريطة مناطق الخدمة" : "Service coverage map"}>
    <div class="cov-map-canvas">
      <img src="/images/maps/middle-east.svg" alt="" width={W} height={H} loading="lazy" decoding="async" />
      <svg class="cov-map-overlay" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" lang={lang}>
        <defs>
          <marker id="cov-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0L10 5L0 10Z" fill="currentColor" />
          </marker>
        </defs>
        <g class="cov-arrows">{arrows.map((l) => <path d={l.d} marker-end="url(#cov-arrow)" />)}</g>
        <g class="cov-pins">{PLACES.map((p) => (
          <g class:list={["cov-pin", { "cov-pin--region": p.region }]} transform={`translate(${p.x} ${p.y})`}>
            <path d={pin} /><circle cy="-13.5" r="2.6" />
          </g>
        ))}</g>
        <g class="cov-labels">{PLACES.map((p) => (
          <text x={p.lx} y={p.ly} text-anchor={p.a} class:list={{ "is-region": p.region, "is-hq": p.hq }}>{ar ? p.ar : p.en}</text>
        ))}</g>
      </svg>
    </div>
  </div>
  <figcaption class="cov-map-legend">
    <span><svg viewBox="-8 -22 16 23" aria-hidden="true"><path d={pin} class="lg-sa" /></svg>{ar ? "مدن نخدمها داخل المملكة" : "Cities we serve in Saudi Arabia"}</span>
    <span><svg viewBox="-8 -22 16 23" aria-hidden="true"><path d={pin} class="lg-region" /></svg>{ar ? "دول نخدمها في المنطقة" : "Countries we serve in the region"}</span>
    <span class="cov-map-hint">{ar ? "اسحب الخريطة لرؤيتها كاملة" : "Swipe to see the whole map"}</span>
  </figcaption>
  <div class="sr-only">
    <p>{ar ? "المدن داخل المملكة:" : "Cities in Saudi Arabia:"}</p>
    <ul>{saudi.map((p) => <li>{ar ? p.ar : p.en}</li>)}</ul>
    <p>{ar ? "في المنطقة:" : "In the region:"}</p>
    <ul>{region.map((p) => <li>{ar ? p.ar : p.en}</li>)}</ul>
  </div>
</figure>

<script>
  // On narrow screens the map scrolls sideways; start with Saudi Arabia in view.
  for (const el of document.querySelectorAll<HTMLElement>(".cov-map-scroll")) {
    const extra = el.scrollWidth - el.clientWidth;
    if (extra > 0) el.scrollLeft = extra * 0.58;
  }
</script>
