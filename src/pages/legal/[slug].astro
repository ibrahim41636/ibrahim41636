---
import Legal from "@/views/Legal.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths() {
  return (await getCollection("legal", (d) => d.id.startsWith("en/"))).map((doc) => ({ params: { slug: doc.data.translationKey }, props: { doc } }));
}
---
<Legal lang="en" doc={Astro.props.doc} />
