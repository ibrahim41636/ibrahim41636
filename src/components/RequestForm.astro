---
import Icon from "./Icon.astro";
import { COMMON, SERVICES, UPLOAD, serviceFields, fieldsFor, type FormKind } from "@/lib/forms";
import { renderField } from "@/lib/form-render";
import { href, t, type Lang } from "@/i18n/ui";

interface Props { lang: Lang; kind: FormKind; service?: string }
const { lang, kind, service } = Astro.props;
const careers = kind === "careers";
const receivedPath = careers ? "/careers/received/" : "/request/received/";
const preset = service && SERVICES[service] ? service : undefined;
const ui = { requiredText: t(lang, "form.required"), optionalText: t(lang, "form.optional"), selectPlaceholder: lang === "ar" ? "اختر…" : "Select…" };
const r = (f: Parameters<typeof renderField>[0], full = false) => renderField(f, lang, { ...ui, full });
const allFields = fieldsFor(kind, preset);
const serviceField = allFields.find((f) => f.name === "service")!;
const steps = kind === "request"
  ? [
      { title: lang === "ar" ? "ما الذي تحتاجه؟" : "What do you need?", lead: lang === "ar" ? "يساعدنا ذلك على توجيه طلبك إلى المختص المناسب." : "This helps us route your request to the right specialist." },
      { title: lang === "ar" ? "تفاصيل المشروع" : "Project details", lead: lang === "ar" ? "شارك ما تعرفه الآن؛ يمكننا استكمال التفاصيل لاحقاً." : "Share what you know now — we can fill in the gaps together." },
      { title: lang === "ar" ? "بيانات التواصل" : "Your contact details", lead: lang === "ar" ? "سيتواصل معك مختص بيئي لمراجعة متطلباتك." : "An environmental specialist will contact you to review your requirements." },
    ]
  : careers
    ? [{ title: lang === "ar" ? "قدّم طلبك" : "Apply to join Selorin", lead: "" }]
    : [{ title: lang === "ar" ? "أرسل استفسارك" : "Send an inquiry", lead: "" }];
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---
<form class="form-shell" method="post" action="/api/request" enctype="multipart/form-data" novalidate data-request-form data-kind={kind} data-lang={lang} data-preset={preset ?? ""} data-received={href(lang, receivedPath)}>
  <input type="hidden" name="kind" value={kind} />
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="sourcePage" value="" data-source />
  <input type="hidden" name="referrer" value="" data-referrer />
  <input type="hidden" name="startedAt" value="" data-started />
  {["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"].map((n) => <input type="hidden" name={n} value="" data-utm={n} />)}
  <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

  {steps.length > 1 && (
    <div class="form-progress" aria-hidden="true">{steps.map((_, i) => <span class:list={[{ done: i === 0 }]} data-progress={i} />)}</div>
  )}
  <div class="form-alert" role="alert" hidden data-alert></div>

  {kind === "request" ? (
    <>
      <section class="form-step" data-step="0" aria-labelledby="step0-title">
        <p class="eyebrow">{t(lang, "form.step")} 1 {t(lang, "form.of")} 3</p>
        <h2 id="step0-title" tabindex="-1">{steps[0].title}</h2>
        <p class="muted">{steps[0].lead}</p>
        <div class="form-grid">
          {preset ? (
            <div class="field full">
              <input type="hidden" name="service" value={preset} />
              <div class="service-chip">
                <div><small>{t(lang, "form.serviceSelected")}</small><b>{SERVICES[preset][lang]}</b></div>
                <a class="link" href={href(lang, "/request/")}>{t(lang, "form.change")}</a>
              </div>
            </div>
          ) : <Fragment set:html={r(serviceField, true)} />}
          <Fragment set:html={r(COMMON.industry)} />
          <Fragment set:html={r(COMMON.location)} />
          <label class="urgent full">
            <input type="checkbox" name="urgent" value="yes" />
            <span><b>{t(lang, "form.urgent")}</b><small>{t(lang, "form.urgentHint")}</small></span>
          </label>
        </div>
        <div class="form-nav"><span></span><button class="btn" type="button" data-next>{t(lang, "form.next")} <Icon name="arrow" class="arrow" /></button></div>
      </section>

      <section class="form-step" data-step="1" aria-labelledby="step1-title" hidden>
        <p class="eyebrow">{t(lang, "form.step")} 2 {t(lang, "form.of")} 3</p>
        <h2 id="step1-title" tabindex="-1">{steps[1].title}</h2>
        <p class="muted">{steps[1].lead}</p>
        <div class="form-grid">
          <div class="full" style="display:contents" data-service-fields>
            <Fragment set:html={preset ? serviceFields(preset).map((f) => r(f)).join("") : ""} />
          </div>
          <Fragment set:html={r(COMMON.description, true)} />
          <div class="field full" data-field="attachments">
            <span id="att-label" style="font-size:var(--fs-14);font-weight:600">{t(lang, "form.attachments")} <span class="opt">({t(lang, "form.optional")})</span></span>
            <div class="dropzone" data-dropzone>
              <Icon name="upload" class="mt-0" />
              <span>{lang === "ar" ? "اسحب الملفات هنا أو اضغط للاختيار" : "Drag files here or click to browse"}</span>
              <input type="file" name="attachments" multiple accept={UPLOAD.accept} aria-labelledby="att-label" aria-describedby="att-hint f-attachments-error" />
            </div>
            <span class="hint" id="att-hint">{t(lang, "form.attachmentsHint")}</span>
            <ul class="file-list" data-file-list></ul>
            <span class="error" id="f-attachments-error" aria-live="polite"></span>
          </div>
        </div>
        <div class="form-nav"><button class="btn btn--ghost" type="button" data-back>{t(lang, "form.back")}</button><button class="btn" type="button" data-next>{t(lang, "form.next")} <Icon name="arrow" class="arrow" /></button></div>
      </section>

      <section class="form-step" data-step="2" aria-labelledby="step2-title" hidden>
        <p class="eyebrow">{t(lang, "form.step")} 3 {t(lang, "form.of")} 3</p>
        <h2 id="step2-title" tabindex="-1">{steps[2].title}</h2>
        <p class="muted">{steps[2].lead}</p>
        <div class="form-grid">
          <Fragment set:html={[COMMON.company, COMMON.contactName, COMMON.jobTitle, COMMON.email, COMMON.phone, COMMON.preferredContact].map((f) => r(f)).join("")} />
          <div class="field full" data-field="consent">
            <label class="check"><input type="checkbox" name="consent" value="yes" required aria-describedby="f-consent-error" /><span>{t(lang, "form.consent")} <a href={href(lang, "/legal/privacy/")} target="_blank">{t(lang, "form.privacy")}</a>.</span></label>
            <span class="error" id="f-consent-error" aria-live="polite"></span>
          </div>
          {turnstileKey && <div class="full cf-turnstile" data-sitekey={turnstileKey} data-language={lang} data-theme="light"></div>}
        </div>
        <div class="form-nav"><button class="btn btn--ghost" type="button" data-back>{t(lang, "form.back")}</button><button class="btn" type="submit" data-submit>{t(lang, "form.submit")} <Icon name="arrow" class="arrow" /></button></div>
      </section>
    </>
  ) : (
    <section class="form-step" data-step="0" aria-labelledby="step0-title">
      <h2 id="step0-title" tabindex="-1">{steps[0].title}</h2>
      <div class="form-grid">
        <Fragment set:html={allFields.map((f) => r(f, f.name === "service")).join("")} />
        <div class="field full" data-field="attachments">
          <span id="att-label" style="font-size:var(--fs-14);font-weight:600">{careers ? (lang === "ar" ? "السيرة الذاتية والمرفقات" : "CV and attachments") : t(lang, "form.attachments")} <span class="opt">({t(lang, "form.optional")})</span></span>
          <div class="dropzone" data-dropzone>
            <span>{lang === "ar" ? "اسحب الملفات هنا أو اضغط للاختيار" : "Drag files here or click to browse"}</span>
            <input type="file" name="attachments" multiple accept={UPLOAD.accept} aria-labelledby="att-label" aria-describedby="att-hint f-attachments-error" />
          </div>
          <span class="hint" id="att-hint">{careers ? (lang === "ar" ? "يُفضّل إرفاق سيرتك الذاتية بصيغة PDF أو Word، وبحجم إجمالي لا يتجاوز 10 ميجابايت." : "Please attach your CV as PDF or Word, up to 10 MB in total.") : t(lang, "form.attachmentsHint")}</span>
          <ul class="file-list" data-file-list></ul>
          <span class="error" id="f-attachments-error" aria-live="polite"></span>
        </div>
        <div class="field full" data-field="consent">
          <label class="check"><input type="checkbox" name="consent" value="yes" required aria-describedby="f-consent-error" /><span>{careers ? (lang === "ar" ? "أوافق على معالجة سيلورين لبياناتي لغرض تقييم طلب التوظيف، وفق" : "I agree to Selorin processing my details to assess my application, as described in the") : t(lang, "form.consent")} <a href={href(lang, "/legal/privacy/")} target="_blank">{t(lang, "form.privacy")}</a>.</span></label>
          <span class="error" id="f-consent-error" aria-live="polite"></span>
        </div>
        {turnstileKey && <div class="full cf-turnstile" data-sitekey={turnstileKey} data-language={lang}></div>}
      </div>
      <div class="form-nav"><span></span><button class="btn" type="submit" data-submit>{careers ? (lang === "ar" ? "إرسال الطلب" : "Submit application") : lang === "ar" ? "إرسال الاستفسار" : "Send Inquiry"} <Icon name="arrow" class="arrow" /></button></div>
    </section>
  )}
</form>
{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  import { initRequestForm } from "@/scripts/request-form";
  document.querySelectorAll<HTMLFormElement>("[data-request-form]").forEach(initRequestForm);
</script>
