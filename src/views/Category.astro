---
import { categoryImage, IMAGES } from "@/data/imagery";
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import Logo from "@/components/Logo.astro";
import BrandedPhoto from "@/components/BrandedPhoto.astro";
import { href, t, type Lang } from "@/i18n/ui";
import { categoryById } from "@/data/taxonomy";
import { getServices, getIndustries } from "@/lib/content";
import { INDUSTRY_ICON } from "@/lib/icons";
import { collectionSchema } from "@/lib/schema";
interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const ar = lang === "ar";
const cat = categoryById(id);
const services = (await getServices()).filter((s) => s.data.category === id);
const indIds = [...new Set(services.flatMap((s) => s.data.industries.map((r) => r.id)))];
const industries = (await getIndustries()).filter((i) => indIds.includes(i.id));
const path = `/services/${id}/`;
const crumbs = [{ name: t(lang, "nav.home"), path: "/" }, { name: t(lang, "nav.services"), path: "/services/" }, { name: cat.name[lang], path }];
---
<Base lang={lang} path={path} breadcrumbs={crumbs}
  title={ar ? `${cat.name.ar} | خدمات بيئية في المملكة` : `${cat.name.en} Services in Saudi Arabia`}
  description={cat.summary[lang]}
  schema={[collectionSchema(lang, path, cat.name[lang], services.map((s) => ({ name: s.data[lang].name, path: `/services/${s.id}/` })))]}
  analytics={{ page_type: "service_category", service_category: id }}>
  <PageHero lang={lang} crumbs={crumbs} photo={categoryImage(cat.id)} eyebrow={t(lang, "nav.services")} title={cat.name[lang]} lead={cat.intro[lang]}>
    <div class="actions mt-6"><a class="btn btn--light" href={href(lang, "/request/")} data-cta="category_hero_request">{t(lang, "cta.consultation")} <Icon name="arrow" class="arrow" /></a></div>
  </PageHero>
  {cat.sectors && (
    <nav class="sector-tabs" aria-label={ar ? "أقسام الصفحة" : "Page sections"}>
      <div class="container">{cat.sectors.map((sc) => <a href={`#${sc.id}`}><Icon name={sc.icon} />{sc.title[lang]}</a>)}</div>
    </nav>
  )}
  {cat.sectors?.map((sc, i) => (
    <section class:list={["section sector", i % 2 === 1 && "bg-white border-top", i > 0 && i % 2 === 0 && "border-top"]} id={sc.id}>
      <div class:list={["container split split--even sector-grid", i % 2 === 1 && "sector-grid--flip"]}>
        <div class="sector-media">
          {sc.image ? <BrandedPhoto img={IMAGES[sc.image as keyof typeof IMAGES]} lang={lang} /> : (
            <div class="sector-panel">
              <span class="sector-panel-icon"><Icon name={sc.icon} /></span>
              {sc.extra && <ul>{sc.extra.items.map((it) => <li><b>{it.name[lang]}</b><span>{it.note[lang]}</span></li>)}</ul>}
              <span class="photo-badge" aria-hidden="true"><Logo /><b>Selorin</b></span>
            </div>
          )}
        </div>
        <div>
          <p class="eyebrow">{String(i + 1).padStart(2, "0")} · {cat.name[lang]}</p>
          <h2>{sc.title[lang]}</h2>
          <p class="lead">{sc.lead[lang]}</p>
          <ul class="check-list">{sc.points.map((pt) => <li><Icon name="check" /><span>{pt[lang]}</span></li>)}</ul>
          {sc.extra && sc.image && <p><b>{sc.extra.title[lang]}</b></p>}
          <div class="sector-links">{sc.services.map((slug) => {
            const sv = services.find((x) => x.id === slug);
            return sv && <a class="pill" href={href(lang, `/services/${slug}/`)}>{sv.data[lang].name}</a>;
          })}</div>
          <div class="actions mt-6"><a class="btn" href={href(lang, `/request/?service=${sc.services[0]}`)} data-cta={`sector_${sc.id}`}>{ar ? "اطلب عرض سعر" : "Request a quote"} <Icon name="arrow" class="arrow" /></a></div>
        </div>
      </div>
    </section>
  ))}
  {cat.facts && (
    <section class="section bg-white border-top">
      <div class="container"><div class="stats stats--3">{cat.facts.map((f) => <div class="stat"><b>{f.value}</b><span>{f.label[lang]}</span></div>)}</div></div>
    </section>
  )}
  <section class:list={["section", cat.sectors && "border-top"]}>
    <div class="container">
      <div class="section-head"><h2>{ar ? "الخدمات في هذا المجال" : "Services in this practice area"}</h2><p class="lead">{cat.benefit[lang]}</p></div>
      <div class="grid grid-3">{services.map((s) => <ServiceCard lang={lang} service={s} />)}</div>
    </div>
  </section>
  {cat.process && (
    <section class="section bg-white border-top">
      <div class="container">
        <div class="section-head"><p class="eyebrow">{ar ? "كيف ننفذ" : "How we deliver"}</p><h2>{ar ? "من الدراسة حتى التشغيل والصيانة" : "From study to operation and maintenance"}</h2></div>
        <ol class="steps" style="list-style:none;padding:0">{cat.process.map((st) => <li class="step"><h3>{st.title[lang]}</h3><p>{st.body[lang]}</p></li>)}</ol>
      </div>
    </section>
  )}
  <section class:list={["section", cat.process ? "border-top" : "bg-white border-top"]}>
    <div class="container">
      <div class="section-head"><h2>{ar ? "القطاعات التي نخدمها" : "Industries we support"}</h2></div>
      <div class="grid grid-4" style="gap:12px">{industries.map((ind) => <a class="tile" href={href(lang, `/industries/${ind.id}/`)}><Icon name={INDUSTRY_ICON[ind.id] ?? "factory"} />{ind.data[lang].name}<Icon name="arrow" class="arrow" /></a>)}</div>
    </div>
  </section>
  <CtaBand title={t(lang, "cta.discuss")} body={t(lang, "service.finalBody")} label={t(lang, "cta.consultation")} to={href(lang, "/request/")} cta="category_final_cta" />
</Base>
