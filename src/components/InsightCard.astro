---
import Picture from "@/components/Picture.astro";
import { href, t, formatDate, type Lang } from "@/i18n/ui";
import { insightCategories } from "@/data/taxonomy";
import { insightSlug, readingTime, type Insight } from "@/lib/content";
interface Props { lang: Lang; post: Insight }
const { lang, post } = Astro.props;
const d = post.data;
---
<article class="media-card reveal" data-cat={d.category}>
  <Picture src={d.heroImage} alt={d.heroAlt} width={800} height={450} />
  <div class="body">
    <div class="meta"><span class="tag">{insightCategories[d.category][lang]}</span><time datetime={d.date.toISOString()}>{formatDate(lang, d.date)}</time><span>{readingTime(post.body, lang)} {t(lang, "insights.minRead")}</span></div>
    <h3><a href={href(lang, `/insights/${insightSlug(post)}/`)}>{d.title}</a></h3>
    <p class="muted" style="font-size:var(--fs-15);margin:0">{d.description}</p>
  </div>
</article>
