---
import { pageImage } from "@/data/imagery";
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";
import { getCollection } from "astro:content";
import { href, t, type Lang } from "@/i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
const projects = await getCollection("projects", (p) => p.data.status === "published");
const crumbs = [{ name: t(lang, "nav.home"), path: "/" }, { name: t(lang, "nav.projects"), path: "/projects/" }];
const engagementTypes = ar
  ? [["ملفات التصاريح البيئية", "تجهيز ملفات تصاريح الإنشاء والتشغيل والتجديد ومتابعة ملاحظات الجهات المختصة.", "environmental-permitting"], ["برامج الرصد الميداني", "تصميم شبكات رصد الغبار وجودة الهواء والضوضاء وتشغيلها وإعداد تقاريرها.", "environmental-monitoring"], ["دراسات تقييم الأثر البيئي", "دراسات خط الأساس وتقييم الآثار وخطط الإدارة البيئية للمشاريع الجديدة.", "environmental-impact-assessment"], ["رصد VOC لمحطات الوقود", "توريد وتركيب ومعايرة أنظمة الرصد الثابت للمركبات العضوية المتطايرة.", "fuel-station-voc-monitoring"], ["الجاهزية للتفتيش", "تدقيق ما قبل التفتيش وخطط الإجراءات التصحيحية وتنظيم السجلات.", "environmental-compliance"], ["حصر الانبعاثات والإفصاح", "جرد غازات الاحتباس الحراري وإعداد بيانات الإفصاح البيئي والاجتماعي.", "ghg-carbon-accounting"]]
  : [["Environmental permit applications", "Preparing construction, operation and renewal permit files and following up on authority comments.", "environmental-permitting"], ["Field monitoring programmes", "Designing, running and reporting dust, air quality and noise monitoring networks.", "environmental-monitoring"], ["Environmental impact assessments", "Baseline studies, impact assessment and environmental management plans for new projects.", "environmental-impact-assessment"], ["Fuel station VOC monitoring", "Supplying, installing and calibrating fixed continuous VOC monitoring systems.", "fuel-station-voc-monitoring"], ["Inspection readiness", "Pre-inspection audits, corrective action plans and organised environmental records.", "environmental-compliance"], ["GHG inventories and disclosure", "Greenhouse gas inventories and data preparation for ESG disclosure.", "ghg-carbon-accounting"]];
---
<Base lang={lang} path="/projects/" breadcrumbs={crumbs}
  title={ar ? "المشاريع ودراسات الحالة | سيلورين" : "Projects & Case Studies | Selorin"}
  description={ar ? "دراسات حالة لأعمال سيلورين في التصاريح البيئية والرصد والدراسات والاستدامة، ونوعية التكليفات التي ننفذها في المملكة." : "Case studies of Selorin's environmental permitting, monitoring, studies and sustainability work, and the types of engagements we deliver in Saudi Arabia."}
  analytics={{ page_type: "projects" }}>
  <PageHero lang={lang} crumbs={crumbs} photo={pageImage("projects")} eyebrow={t(lang, "nav.projects")}
    title={ar ? "أعمال تُقاس بمخرجاتها" : "Work measured by its deliverables"}
    lead={ar ? "نعرض دراسات الحالة بموافقة عملائنا، مع توضيح النطاق والتحدي والمنهجية والمخرجات." : "We publish case studies with our clients' approval, setting out scope, challenge, approach and deliverables."} />
  <section class="section">
    <div class="container">
      {projects.length > 0 && (
        <div class="grid grid-3 mb-6">
          {projects.map((p) => (
            <article class="card"><p class="meta"><span class="tag">{p.data[lang].clientType}</span><span>{p.data[lang].location}</span></p>
              <h2 style="font-size:var(--fs-h4);margin:0"><a class="card-link" href={href(lang, `/projects/${p.id}/`)} style="text-decoration:none">{p.data[lang].title}</a></h2><p>{p.data[lang].summary}</p></article>
          ))}
        </div>
      )}
      <div class:list={["section-head", { "mt-7": projects.length > 0 }]}><div><p class="eyebrow">{ar ? "نوعية التكليفات" : "Types of engagement"}</p><h2>{ar ? "ما الذي نعمل عليه عادةً" : "What we typically work on"}</h2></div><p class="lead">{ar ? "أمثلة على نطاقات العمل، وليست دراسات حالة لعملاء محددين." : "Examples of engagement scopes — not case studies of specific clients."}</p></div>
      <div class="grid grid-3">
        {engagementTypes.map(([h, p, s]) => (
          <article class="card"><h3>{h}</h3><p>{p}</p><a class="link" href={href(lang, `/services/${s}/`)}>{t(lang, "cta.exploreService")} <Icon name="arrow" /></a></article>
        ))}
      </div>
    </div>
  </section>
  <CtaBand title={ar ? "لنناقش مشروعك القادم" : "Let's discuss your next project"} body={t(lang, "service.finalBody")} label={t(lang, "cta.discuss")} to={href(lang, "/request/")} cta="projects_final_cta" />
</Base>
