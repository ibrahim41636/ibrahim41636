---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { href, site, t, type Lang } from "@/i18n/ui";
import { categories } from "@/data/taxonomy";
import { getIndustries } from "@/lib/content";

interface Props { lang: Lang; focused?: boolean }
const { lang, focused = false } = Astro.props;
const industries = (await getIndustries()).slice(0, 8);
---
<footer class="site-footer on-dark">
  <div class="container">
    {!focused && (
      <div class="footer-top">
        <div>
          <a class="brand" href={href(lang, "/")} aria-label="Selorin">
            <Logo />
            <span class="brand-text"><b>Selorin</b><small>ENVIRONMENTAL ADVISORY & SERVICES</small></span>
          </a>
          <p style="margin-top:20px;max-width:38ch">{t(lang, "footer.tagline")}</p>
          <ul style="margin-top:20px">
            <li><a href={`mailto:${site.email}`} data-track="email_click" data-cta="footer_email">{site.email}</a></li>
            <li><a href={`tel:${site.phoneHref}`} class="ltr" data-track="phone_click" data-cta="footer_phone">{site.phone}</a></li>
            <li>{site.country[lang]}</li>
            <li><a href={site.profilePdf} download data-cta="footer_profile">{lang === "ar" ? "تحميل الملف التعريفي (PDF)" : "Download company profile (PDF)"}</a></li>
          </ul>
          {(site.social.linkedin || site.social.x) && (
            <div class="socials">
              {site.social.linkedin && <a href={site.social.linkedin} aria-label="LinkedIn" rel="noopener" target="_blank"><Icon name="linkedin" /></a>}
              {site.social.x && <a href={site.social.x} aria-label="X" rel="noopener" target="_blank"><Icon name="x" /></a>}
            </div>
          )}
        </div>
        <div>
          <h2>{t(lang, "nav.services")}</h2>
          <ul>
            {categories.map((c) => <li><a href={href(lang, `/services/${c.id}/`)}>{c.name[lang]}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>{t(lang, "nav.industries")}</h2>
          <ul>
            {industries.map((i) => <li><a href={href(lang, `/industries/${i.id}/`)}>{i.data[lang].name}</a></li>)}
            <li><a href={href(lang, "/industries/")}>{t(lang, "nav.allIndustries")}</a></li>
          </ul>
        </div>
        <div>
          <h2>{t(lang, "footer.company")}</h2>
          <ul>
            <li><a href={href(lang, "/about/")}>{t(lang, "nav.about")}</a></li>
            <li><a href={href(lang, "/projects/")}>{t(lang, "nav.projects")}</a></li>
            <li><a href={href(lang, "/careers/")}>{lang === "ar" ? "الوظائف" : "Careers"}</a></li>
            <li><a href={href(lang, "/contact/")}>{t(lang, "nav.contact")}</a></li>
            <li><a href={href(lang, "/request/")}>{t(lang, "cta.consultation")}</a></li>
          </ul>
        </div>
        <div>
          <h2>{t(lang, "nav.insights")}</h2>
          <ul>
            <li><a href={href(lang, "/insights/")}>{t(lang, "insights.all")}</a></li>
            <li><a href={href(lang, "/insights/category/environmental-compliance/")}>{lang === "ar" ? "الامتثال البيئي" : "Environmental Compliance"}</a></li>
            <li><a href={href(lang, "/insights/category/technical-articles/")}>{lang === "ar" ? "مقالات فنية" : "Technical Articles"}</a></li>
            <li><a href={href(lang, "/insights/category/esg/")}>{lang === "ar" ? "الحوكمة البيئية والاجتماعية" : "ESG"}</a></li>
          </ul>
        </div>
      </div>
    )}
    <div class="footer-bottom">
      <span>{t(lang, "footer.copyright")} · {lang === "ar" ? "شركة سيلورين، الرقم الوطني الموحد" : "Selorin Company, CR"} <span class="ltr">7054829457</span></span>
      <nav aria-label={t(lang, "footer.legal")}>
        <a href={href(lang, "/legal/privacy/")}>{t(lang, "footer.privacy")}</a>
        <a href={href(lang, "/legal/terms/")}>{t(lang, "footer.terms")}</a>
        <a href={href(lang, "/legal/cookies/")}>{t(lang, "footer.cookies")}</a>
        <a href={href(lang, "/sitemap/")}>{t(lang, "footer.sitemap")}</a>
        <button type="button" data-cookie-settings>{t(lang, "footer.cookieSettings")}</button>
      </nav>
    </div>
  </div>
</footer>
