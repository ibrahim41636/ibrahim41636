---
import Picture from "@/components/Picture.astro";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import LiveReadings from "@/components/LiveReadings.astro";
import Contours from "@/components/Contours.astro";
import CtaBand from "@/components/CtaBand.astro";
import InsightCard from "@/components/InsightCard.astro";
import { href, site, t, type Lang } from "@/i18n/ui";
import { categories, lifecycle, regulators } from "@/data/taxonomy";
import { getServices, getIndustries, getInsights } from "@/lib/content";
import { SERVICE_ICON, INDUSTRY_ICON } from "@/lib/icons";
import { collectionSchema } from "@/lib/schema";
import OrgMarquee from "@/components/OrgMarquee.astro";
import { COMPANY, TEAM } from "@/data/team";
import { IMAGES } from "@/data/imagery";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
const services = await getServices();
const byId = Object.fromEntries(services.map((s) => [s.id, s]));
const industries = await getIndustries();
const insights = (await getInsights(lang)).slice(0, 3);
const monitoring = ["dust-monitoring", "fuel-station-voc-monitoring", "air-quality-monitoring", "noise-monitoring"].map((id) => byId[id]).filter(Boolean);

const copy = ar
  ? {
      title: "سيلورين | مكتب استشارات بيئية في السعودية ودول الخليج",
      description: "مكتب استشارات بيئية في السعودية يخدم الرياض وجدة والدمام وجميع المناطق: استخراج التصريح البيئي، ودراسات تقييم الأثر البيئي، والرصد البيئي، وإدارة النفايات، والطاقة الشمسية.",
      eyebrow: "استشارات وخدمات بيئية · المملكة العربية السعودية",
      h1: "وضوح بيئي للمشاريع المعقّدة.",
      lead: "تساعد سيلورين المنشآت في المملكة العربية السعودية ودول الخليج على استخراج التصاريح البيئية، والوفاء بالمتطلبات التنظيمية، وقياس الأداء البيئي، وبناء برامج استدامة موثوقة — بدقة فنية في كل مرحلة.",
      example: "مثال توضيحي لبيانات الرصد",
    }
  : {
      title: "Selorin | Environmental Consultants in Saudi Arabia & the GCC",
      description: "Environmental consultants in Saudi Arabia serving Riyadh, Jeddah, Dammam and every region: environmental permits, EIA, monitoring, waste management and solar energy.",
      eyebrow: "Environmental advisory & services · Saudi Arabia",
      h1: "Environmental clarity for complex projects.",
      lead: "Selorin helps organizations across Saudi Arabia secure permits, meet regulatory requirements, measure environmental performance and build credible sustainability programmes — with technical accuracy at every stage.",
      example: "Illustrative monitoring data",
    };

const pillars = ar
  ? [
      ["ما نقدّمه", "التصاريح والامتثال، والدراسات البيئية، والرصد الميداني، وإدارة النفايات، واستشارات الاستدامة — ضمن فريق واحد مسؤول عن النتيجة."],
      ["من نخدم", "المنشآت الصناعية، والمقاولون، والمطوّرون العقاريون، ومشاريع البنية التحتية والطاقة، والجهات الحكومية، والمنشآت التجارية."],
      ["أين نعمل", "في مختلف مناطق المملكة العربية السعودية، وفق المتطلبات التنظيمية الوطنية واشتراطات المدن الصناعية والهيئات المختصة."],
      ["لماذا يختارنا العملاء", "فهم دقيق للمتطلبات المحلية، ومخرجات واضحة يمكن الدفاع عنها، وربط مباشر بين البيانات الميدانية والقرار."],
    ]
  : [
      ["What we do", "Permitting and compliance, environmental studies, field monitoring, waste management and sustainability advisory — delivered by one accountable team."],
      ["Who we serve", "Industrial facilities, contractors, real estate developers, infrastructure and energy projects, government entities and commercial operators."],
      ["Where we operate", "Across Saudi Arabia, working to national environmental requirements and the conditions of industrial cities and competent authorities."],
      ["Why clients choose us", "Precise understanding of local requirements, clear and defensible deliverables, and a direct line from field data to decisions."],
    ];

const stats = [
  [`${COMPANY.yearsExperience}`, ar ? "سنوات من الخبرة في الخدمات البيئية" : "years of environmental services experience"],
  [`${categories.length}`, ar ? "مجالات خدمات مترابطة" : "connected practice areas"],
  [`${services.length}`, ar ? "خدمة بيئية متخصصة" : "specialist environmental services"],
  [`${industries.length}`, ar ? "قطاعاً نخدمه في المملكة" : "sectors served across Saudi Arabia"],
];
const sectors = [
  { img: IMAGES.offshoreWind, to: "/services/net-zero-advisory/", kicker: ar ? "الاستدامة والمناخ" : "Sustainability & climate", title: ar ? "خرائط طريق عملية نحو الحياد الصفري" : "Practical roadmaps to net zero" },
  { img: IMAGES.powerPlant, to: "/industries/energy/", kicker: ar ? "الطاقة والمرافق" : "Energy & utilities", title: ar ? "امتثال بيئي لمحطات التوليد والمرافق" : "Environmental compliance for power and utilities" },
  { img: IMAGES.refinery, to: "/industries/oil-gas/", kicker: ar ? "النفط والغاز" : "Oil & gas", title: ar ? "امتثال الانبعاثات والمركبات العضوية المتطايرة" : "Emissions and VOC compliance" },
  { img: IMAGES.openPitMine, to: "/industries/mining-quarrying/", kicker: ar ? "التعدين والمحاجر" : "Mining & quarrying", title: ar ? "رصد الغبار وضبطه في المواقع المفتوحة" : "Dust monitoring and control on open sites" },
  { img: IMAGES.windAerial, to: "/services/environmental-impact-assessment/", kicker: ar ? "الطاقة المتجددة" : "Renewable energy", title: ar ? "دراسات بيئية لمشاريع الرياح والشمس" : "Environmental studies for wind and solar" },
];

const how = ar
  ? [["نفهم", "نراجع أنشطتك واشتراطات تصريحك والمخاطر الفعلية في موقعك."], ["نقيّم", "نحدد المتطلبات المنطبقة والفجوات والبيانات اللازمة."], ["ننفّذ", "نُعدّ الدراسات والخطط ونجري القياسات الميدانية."], ["نقدّم", "نجهّز المستندات ونتابع ملاحظات الجهات المختصة."], ["ندعم", "نتابع الامتثال والرصد والتقارير طوال عمر المشروع."]]
  : [["Understand", "We review your activities, permit conditions and the real risks on site."], ["Assess", "We identify applicable requirements, gaps and the data needed."], ["Deliver", "We prepare studies and plans and carry out field measurements."], ["Submit", "We prepare documentation and follow up on authority comments."], ["Support", "We sustain compliance, monitoring and reporting over the project life."]];
const CITIES: [string, string][] = [
  ["Riyadh", "الرياض"], ["Jeddah", "جدة"], ["Makkah", "مكة المكرمة"], ["Madinah", "المدينة المنورة"], ["Dammam & Khobar", "الدمام والخبر"],
  ["Jubail", "الجبيل"], ["Yanbu", "ينبع"], ["Tabuk & NEOM", "تبوك ونيوم"], ["Abha", "أبها"], ["Qassim", "القصيم"], ["Hail", "حائل"], ["Jazan", "جازان"],
];
---
<Base lang={lang} path="/" title={copy.title} description={copy.description} image="/images/og-default.jpg"
  schema={[collectionSchema(lang, "/services/", ar ? "خدمات سيلورين" : "Selorin services", services.map((s) => ({ name: s.data[lang].name, path: `/services/${s.id}/` })))]}
  analytics={{ page_type: "home" }}>

  <section class="hero on-dark">
    <div class="hero-media"><Picture src="/images/hero-fields.jpg" alt="" width={1600} height={900} loading="eager" fetchpriority="high" style="opacity:.42" srcsetWebp="/images/hero-fields-960.webp 960w, /images/hero-fields.webp 1600w" sizes="100vw" /></div>
    <Contours />
    <div class="container hero-inner">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1 class="display">{copy.h1}</h1>
        <p class="lead">{copy.lead}</p>
        <div class="actions">
          <a class="btn btn--light" href={href(lang, "/request/")} data-cta="hero_consultation">{t(lang, "cta.consultation")} <Icon name="arrow" class="arrow" /></a>
          <a class="btn btn--ghost" href={href(lang, "/services/")} data-cta="hero_services">{t(lang, "cta.explore")}</a>
          <a class="btn btn--ghost" href={site.profilePdf} download data-cta="hero_profile"><Icon name="download" /> {ar ? "الملف التعريفي" : "Company profile"}</a>
        </div>
      </div>
      <LiveReadings lang={lang} label={copy.example} />
    </div>
  </section>

  <section class="section-tight bg-white">
    <div class="container">
      <div class="pillars">
        {pillars.map(([h, p]) => <div class="pillar reveal"><h2 class="h3-like" style="font-size:var(--fs-14);text-transform:uppercase;letter-spacing:.1em;color:var(--c-forest-2);margin-bottom:12px">{h}</h2><p>{p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="h-experience">
    <div class="container">
      <h2 id="h-experience" class="sr-only">{ar ? "سيلورين في أرقام" : "Selorin at a glance"}</h2>
      <div class="stats">{stats.map(([n, l]) => <div class="stat reveal"><b>{n}</b><span>{l}</span></div>)}</div>
    </div>
  </section>

  <section class="section" id="services">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t(lang, "nav.services")}</p>
          <h2>{ar ? "سبعة مجالات تغطي دورة الالتزام البيئي والطاقة النظيفة" : "Seven practice areas covering the environmental lifecycle and clean energy"}</h2>
        </div>
        <p class="lead">{ar ? "من أول تقييم للموقع إلى الامتثال المستمر — اختر المجال الأقرب لاحتياجك." : "From the first site assessment to ongoing compliance — start with the area closest to your need."}</p>
      </div>
      <div class="grid grid-3">
        {categories.map((c) => {
          const items = services.filter((s) => s.data.category === c.id);
          return (
            <article class:list={["card reveal", c.id === "renewable-energy" && "card--span"]}>
              <span class="icon"><Icon name={c.icon} /></span>
              <h3><a class="card-link" href={href(lang, `/services/${c.id}/`)} style="text-decoration:none" data-cta="home_practice_area">{c.name[lang]}</a></h3>
              <p>{c.summary[lang]}</p>
              <ul class="card-list">{items.slice(0, c.id === "renewable-energy" ? 6 : 4).map((s) => <li><a href={href(lang, `/services/${s.id}/`)} data-cta="home_service_link" data-service={s.id}>{s.data[lang].name}</a></li>)}</ul>
              <p class="benefit"><Icon name="check" /><span>{c.benefit[lang]}</span></p>
              <span class="link" aria-hidden="true">{t(lang, "cta.exploreService")} <Icon name="arrow" /></span>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="h-sectors-visual">
    <div class="container">
      <h2 id="h-sectors-visual" class="sr-only">{ar ? "قطاعات رئيسية" : "Key sectors"}</h2>
      <div class="photo-band">
        {sectors.map((x) => (
          <a class="photo-card reveal" href={href(lang, x.to)} data-cta="home_sector_photo">
            <Picture src={x.img.src} alt={x.img.alt[lang]} width={x.img.width} height={x.img.height} sizes="(max-width: 900px) 100vw, 40vw" />
            <span class="cap"><small>{x.kicker}</small><b>{x.title}</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-ink on-dark" id="lifecycle">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{ar ? "دليل دورة المشروع" : "Project lifecycle navigator"}</p>
          <h2 style="color:#fff">{ar ? "أين يقف مشروعك اليوم؟" : "Where is your project today?"}</h2>
        </div>
        <p class="lead">{ar ? "اختر المرحلة لترى الخدمات التي تحتاجها المشاريع عادةً في هذه المرحلة." : "Choose a stage to see the support projects typically need at that point."}</p>
      </div>
      <div class="navigator" data-tabs>
        <div role="tablist" aria-label={ar ? "مراحل المشروع" : "Project stages"} aria-orientation="vertical">
          {lifecycle.map((st, i) => (
            <button role="tab" type="button" id={`tab-${st.id}`} aria-controls={`panel-${st.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-stage={st.id}>
              <span class="n">0{i + 1}</span><b>{st.name[lang]}</b><small>{st.question[lang]}</small>
            </button>
          ))}
        </div>
        {lifecycle.map((st, i) => (
          <div role="tabpanel" id={`panel-${st.id}`} aria-labelledby={`tab-${st.id}`} hidden={i !== 0} tabindex="0">
            <p class="eyebrow">{st.name[lang]}</p>
            <h3 style="color:#fff">{st.question[lang]}</h3>
            <div class="rec">
              {st.services.map((id) => byId[id] && (
                <a href={href(lang, `/services/${id}/`)} data-cta="lifecycle_service" data-service={id}><Icon name={SERVICE_ICON[id]} />{byId[id].data[lang].name}</a>
              ))}
            </div>
            <a class="btn btn--light" href={href(lang, "/request/")} data-cta={`lifecycle_request_${st.id}`}>{t(lang, "cta.discuss")} <Icon name="arrow" class="arrow" /></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split split--even">
      <div class="reveal">
        <p class="eyebrow">{ar ? "الرصد والقياس" : "Monitoring & measurement"}</p>
        <h2>{ar ? "أدلة مقاسة لما تشدّد عليه الجهات الرقابية" : "Measured evidence for what regulators focus on"}</h2>
        <p class="lead">{ar ? "نصمم برامج رصد للغبار والمركبات العضوية المتطايرة وجودة الهواء والضوضاء، وننفذها ميدانياً، ونقدّم بيانات جاهزة للتقارير التنظيمية." : "We design and run monitoring for dust, VOCs, air quality and noise — and deliver data that is ready for regulatory reporting."}</p>
        <a class="link" href={href(lang, "/services/monitoring-measurement/")} data-cta="home_monitoring">{ar ? "خدمات الرصد والقياس" : "Monitoring services"} <Icon name="arrow" /></a>
      </div>
      <div class="grid grid-2">
        {monitoring.map((s) => (
          <article class="card reveal">
            <span class="icon"><Icon name={SERVICE_ICON[s.id]} /></span>
            <h3><a class="card-link" href={href(lang, `/services/${s.id}/`)} style="text-decoration:none" data-cta="home_monitoring_card" data-service={s.id}>{s.data[lang].name}</a></h3>
            <p>{s.data[lang].keyBenefit}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white border-top" id="industries">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t(lang, "nav.industries")}</p>
          <h2>{ar ? "متطلبات مختلفة لكل قطاع" : "Different requirements for every sector"}</h2>
        </div>
        <a class="link" href={href(lang, "/industries/")}>{t(lang, "nav.allIndustries")} <Icon name="arrow" /></a>
      </div>
      <div class="grid grid-4" style="gap:12px">
        {industries.map((ind) => (
          <a class="tile" href={href(lang, `/industries/${ind.id}/`)} data-cta="home_industry_tile"><Icon name={INDUSTRY_ICON[ind.id] ?? "factory"} />{ind.data[lang].name}<Icon name="arrow" class="arrow" /></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-paper-2" id="team">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{ar ? "الكادر الفني" : "Technical team"}</p>
          <h2>{ar ? "خبرات متكاملة خلف كل مشروع" : "Complementary expertise behind every project"}</h2>
        </div>
        <a class="link" href={href(lang, "/about/#team")}>{ar ? "تعرّف على الفريق" : "Meet the team"} <Icon name="arrow" /></a>
      </div>
      <div class="grid grid-4">
        {TEAM.map((m) => (
          <article class="card team-card reveal">
            <span class="avatar" aria-hidden="true">{m.initials[lang]}</span>
            <h3>{m.name[lang]}</h3>
            <p class="focus">{m.focus[lang]}</p>
            <p>{m.bio[lang]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{ar ? "كيف نعمل" : "How we work"}</p>
          <h2>{ar ? "منهجية واضحة من أول اجتماع إلى آخر تقرير" : "A clear method from first meeting to final report"}</h2>
        </div>
        <a class="link" href={href(lang, "/about/#approach")}>{ar ? "منهجيتنا" : "Our approach"} <Icon name="arrow" /></a>
      </div>
      <ol class="steps" style="list-style:none;padding:0">
        {how.map(([h, p]) => <li class="step reveal"><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section bg-paper-2">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{ar ? "المشهد التنظيمي في المملكة" : "Saudi regulatory landscape"}</p>
          <h2>{ar ? "نعمل وفق المتطلبات الوطنية والجهات المختصة" : "Working to national requirements and competent authorities"}</h2>
        </div>
        <p class="lead">{ar ? "قائمة تعريفية بالجهات والأطر التي تحكم العمل البيئي عادةً، ولا تمثل شراكة أو اعتماداً." : "An informational overview of bodies and frameworks that typically govern environmental work — not a statement of partnership or accreditation."}</p>
      </div>
      <ul class="reg-list" style="padding:0">
        {regulators.map((r) => <li><b>{r.name[lang]}</b><span>{r.role[lang]}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="h-coverage">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{ar ? "مناطق الخدمة" : "Service coverage"}</p>
          <h2 id="h-coverage">{ar ? "مكتب استشارات بيئية يخدم جميع مناطق المملكة" : "Environmental consultants serving every region of Saudi Arabia"}</h2>
        </div>
        <p class="lead">{ar ? "ننفذ الزيارات الميدانية والرصد البيئي والدراسات في المدن الرئيسة والمدن الصناعية والمشاريع الكبرى، ونخدم دول الخليج." : "We carry out site visits, environmental monitoring and studies in major cities, industrial cities and giga-projects, and support clients across the GCC."}</p>
      </div>
      <ul class="city-list">{CITIES.map(([en, a]) => <li><Icon name="pin" />{ar ? a : en}</li>)}</ul>
    </div>
  </section>

  {insights.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">{t(lang, "nav.insights")}</p>
            <h2>{ar ? "إرشادات عملية للمتطلبات البيئية" : "Practical guidance on environmental requirements"}</h2>
          </div>
          <a class="link" href={href(lang, "/insights/")}>{ar ? "جميع المقالات" : "All insights"} <Icon name="arrow" /></a>
        </div>
        <div class="grid grid-3">{insights.map((p) => <InsightCard lang={lang} post={p} />)}</div>
      </div>
    </section>
  )}

  <section class="section-tight bg-white border-top" aria-labelledby="h-orgs">
    <div class="container">
      <div class="section-head" style="margin-bottom:var(--space-5)">
        <div>
          <p class="eyebrow">{ar ? "عملاؤنا" : "Our clients"}</p>
          <h2 id="h-orgs">{ar ? "جهات نعتز بخدمتها" : "Organisations we support"}</h2>
        </div>
      </div>
    </div>
    <OrgMarquee lang={lang} label={ar ? "شعارات عملائنا" : "Client logos"} />
  </section>

  <CtaBand title={ar ? "ناقش متطلبات مشروعك مع مختص بيئي" : "Discuss your project with an environmental specialist"}
    body={ar ? "أخبرنا عن موقعك وأنشطتك والمرحلة التي يمر بها مشروعك، وسنوضح لك المتطلبات المنطبقة والخطوات التالية." : "Tell us about your site, activities and project stage. We will clarify the applicable requirements and the next steps."}
    label={t(lang, "cta.consultation")} to={href(lang, "/request/")} cta="home_final_cta"
    secondary={{ label: ar ? "اتصل بنا" : "Call us", to: "tel:+966534302332" }} />
</Base>
