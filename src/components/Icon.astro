---
import { ICONS } from "@/lib/icons";
interface Props { name: string; class?: string; label?: string; size?: number }
const { name, class: cls, label, size = 24 } = Astro.props;
const body = ICONS[name] ?? ICONS.doc;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"} focusable="false" set:html={body} />
