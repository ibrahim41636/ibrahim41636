---
import { markRequired } from "@/lib/content";
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary>{f.q}</summary>
      <div class="answer"><p set:html={markRequired(f.a)} /></div>
    </details>
  ))}
</div>
