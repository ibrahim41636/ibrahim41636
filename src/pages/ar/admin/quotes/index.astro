      const head = el("header", {},
        el("h3", { text: `${q.quote_id} · ${q.title}` }),
        el("span", { class: "pill " + (q.status === "paid" ? "paid" : q.status === "cancelled" || q.status === "superseded" ? "cancelled" : q.status === "accepted" || q.status === "change_requested" ? "due" : ""), text: (QS[q.status] || q.status) + (q.negotiable ? "" : " · نهائي") }));
      const who = el("p", { class: "meta" }, dotted([lead.company, lead.contact, lead.email, lead.service, lead.status ? `حالة الطلب: ${LS[lead.status] || lead.status}` : ""]));
      const meta = el("p", { class: "meta", text: `الإجمالي ${sar(q.total)} (قبل الضريبة ${sar(q.subtotal)}) · المدفوع ${sar(paid)} · أُرسل ${date(q.created_at)} · ساري حتى ${q.valid_until}${q.accepted_at ? " · وافق " + date(q.accepted_at) : ""}` });
      const links = el("div", { class: "links" });
      if (lead.portal) links.append(btn("نسخ رابط بوابة العميل", () => copy(lead.portal, "نُسخ رابط البوابة.")));
      if (lead.drive) links.append(el("a", { class: "btn btn--ghost", href: lead.drive, target: "_blank", rel: "noopener", text: "مجلد الطلب على Drive" }));
      if (!["paid", "cancelled", "superseded"].includes(q.status)) links.append(btn("إلغاء العرض", () => act("/api/admin/quotes/cancel", { quoteId: q.quote_id }, `إلغاء العرض ${q.quote_id}؟ تُلغى الدفعات غير المدفوعة وروابطها.`, "أُلغي العرض.")));

      let req = null;
      if (q.change_requested_at) {
        let c = {}; try { c = JSON.parse(q.change_request || "{}"); } catch {}
        const what = [c.discount ? "خصم" : "", c.schedule ? "تقسيم دفعات مختلف" : ""].filter(Boolean).join(" و");
        req = el("div", { class: "q-req" }, `طلب العميل ${what} بتاريخ ${date(q.change_requested_at)}${c.note ? `:\n«${c.note}»` : "."}`);
        if (q.status === "change_requested") req.append(el("br"), btn("إعداد العرض المحدّث (نهائي)", () => { const f = $("[data-create]").elements; f.leadId.value = q.lead_id; f.title.value = q.title; f.final.checked = true; tab("new"); msg(`عدّل القيمة أو الدفعات حسب طلب العميل ثم أرسل. سيحل العرض الجديد محل ${q.quote_id} ويكون نهائياً.`); }, false));
      }
      const note = q.revision_note ? el("p", { class: "meta", text: `التعديلات في هذا الإصدار: ${q.revision_note}` }) : null;
      if (q.status === "superseded" || q.status === "cancelled") {
        return el("details", { class: "q-card q-old" }, el("summary", {}, head), who, meta, note, req, ...q.meetings.map(meetingBox), paymentsTable(q), links);
      }
      return el("article", { class: "q-card" }, head, who, meta, note, req, ...q.meetings.map(meetingBox), contractBox(q), stagesTable(q), paymentsTable(q), links);
    }

    async function loadProjects() {
      try {
        const lead = $("[data-filter]").value.trim().toUpperCase();
        const r = await api(`/api/admin/quotes${lead ? `?lead=${encodeURIComponent(lead)}` : ""}`);
        $("[data-mode]").replaceChildren("الدفع عبر ميسّر: ", el("b", { class: r.payments === "off" ? "off" : "", text: r.payments === "live" ? "مفعّل (حقيقي)" : r.payments === "test" ? "وضع التجربة" : "غير مفعّل" }));
        const list = $("[data-list]");
        list.replaceChildren(...r.quotes.map(quoteCard));
        if (!r.quotes.length) list.append(el("p", { class: "muted", text: lead ? "لا توجد عروض لهذا الطلب بعد." : "لا توجد عروض بعد." }));
      } catch (err) { msg(err.message, true); }
    }

    // ------------------------------------------------ settings
    async function loadSettings() {
      try {
        const r = await api("/api/admin/settings");
        const f = $("[data-settings]").elements;
        for (const k of ["legalName", "crNumber", "vatNumber", "address", "signatoryName", "signatoryTitle", "phone", "email"]) f[k].value = r.profile[k] || "";
        const sig = $("[data-sig]"), stamp = $("[data-stamp]");
        sig.hidden = !r.signature; if (r.signature) sig.src = r.signature;
        stamp.hidden = !r.stamp; if (r.stamp) stamp.src = r.stamp;
        const st = $("[data-status]");
        st.replaceChildren(
          el("li", { text: `Google Drive: ${r.drive.configured ? "مربوط" : "غير مربوط (أضف DRIVE_CLIENT_ID وDRIVE_CLIENT_SECRET وDRIVE_REFRESH_TOKEN في Cloudflare)"}` }, r.drive.root ? el("span", {}, " · ", el("a", { href: r.drive.root, target: "_blank", rel: "noopener", text: "المجلد الرئيسي" })) : null),
          el("li", { text: `الدفع عبر ميسّر: ${r.payments === "live" ? "مفعّل (حقيقي)" : r.payments === "test" ? "وضع التجربة" : "غير مفعّل (أضف MOYASAR_SECRET_KEY)"}` }),
          el("li", { text: `مدة خطوات الفريق: ${r.slaHours} ساعات (QUOTE_SLA_HOURS)` }),
          el("li", { text: `التوقيع: ${r.signature ? "مرفوع" : "غير مرفوع"} · الختم: ${r.stamp ? "مرفوع" : "غير مرفوع"}` }),
        );
      } catch (err) { msg(err.message, true); }
    }
    $("[data-settings]").addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.currentTarget;
      try { await post("/api/admin/settings", new FormData(form)); msg("حُفظت الإعدادات."); form.elements.signature.value = ""; form.elements.stamp.value = ""; loadSettings(); }
      catch (err) { msg(err.message, true); }
    });

    // ------------------------------------------------ session
    function logout() { token = ""; sessionStorage.removeItem(KEY); $("[data-panel]").hidden = true; $("[data-login]").hidden = false; }
    function start() {
      $("[data-login]").hidden = true; $("[data-panel]").hidden = false;
      const qp = new URLSearchParams(location.search).get("lead");
      if (qp) { $("[name=leadId]").value = qp; $("[data-filter]").value = qp; tab("projects"); loadTasks(); } else tab("tasks");
    }
    $("[data-login]").addEventListener("submit", (e) => { e.preventDefault(); token = $("#adm-token").value.trim(); sessionStorage.setItem(KEY, token); start(); });
    $("[data-refresh]").onclick = loadProjects;
    $("[data-filter]").addEventListener("change", loadProjects);
    $("[data-logout]").onclick = logout;
    if (token) start();
  </script>
</Base>
